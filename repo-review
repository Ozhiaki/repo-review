def run_git(args: list[str], cwd: Path = ROOT) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", *args],
        cwd=cwd,
        text=True,
        capture_output=True,
        timeout=10,
        check=False,
    )


def classify_path(path: str, status: str) -> list[str]:
    classifications: list[str] = []
    lower = path.lower()
    if status == "A":
        classifications.append("new-subsystem")
    if status == "D":
        classifications.append("deleted-subsystem")
    if lower.endswith(".md") or lower.startswith("docs/") or lower.startswith("agent/"):
        classifications.append("docs-only")
    if lower.startswith("tests/") or "/test_" in lower or lower.endswith("_test.py"):
        classifications.append("tests-only")
    if lower in {"pyproject.toml", "package.json", "package-lock.json", "requirements.txt"} or lower.endswith(".lock"):
        classifications.append("dependency-config")
    if lower == "repo-review" or lower.startswith("tools/"):
        classifications.append("core-logic")
    if lower.startswith("schemas/"):
        classifications.append("architecture-boundary")
    return classifications or ["core-logic"]


def diff_command(options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    diff_range = options.get("range")
    if not diff_range:
        return fail(
            "missing required --range",
            "Run: repo-review diff --range <from>..<to> --json --no-input",
            valid_values=["--range"],
        ), None

    try:
        limit = int(options.get("limit") or 50)
    except ValueError:
        return fail("invalid --limit", "Use a positive integer for --limit.", valid_values=["1", "10", "50"]), None
    if limit < 1:
        return fail("invalid --limit", "Use a positive integer for --limit.", valid_values=["1", "10", "50"]), None

    repo_root = Path(options.get("repo") or ROOT).expanduser().resolve()
    if not (repo_root / ".git").exists():
        return fail(
            "repo path is not a git checkout",
            "Pass --repo <path> pointing at a git repository.",
            code=4,
            error_code="resource_not_found",
            valid_values=["--repo"],
        ), None

    path_filter = options.get("path")
    pathspec = ["--", path_filter] if path_filter else []
    status_result = run_git(["diff", "--name-status", diff_range, *pathspec], cwd=repo_root)
    if status_result.returncode != 0:
        return fail(
            "git diff --name-status failed",
            status_result.stderr.strip() or "Check that the supplied --range is valid.",
            code=6,
            error_code="external_command_failed",
        ), None
    numstat_result = run_git(["diff", "--numstat", diff_range, *pathspec], cwd=repo_root)
    if numstat_result.returncode != 0:
        return fail(
            "git diff --numstat failed",
            numstat_result.stderr.strip() or "Check that the supplied --range is valid.",
            code=6,
            error_code="external_command_failed",
        ), None

    stats_by_path: dict[str, tuple[int, int]] = {}
    for line in numstat_result.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) < 3:
            continue
        additions = 0 if parts[0] == "-" else int(parts[0])
        deletions = 0 if parts[1] == "-" else int(parts[1])
        stats_by_path[parts[2]] = (additions, deletions)

    changed_files: list[dict[str, Any]] = []
    status_map = {
        "A": "added",
        "M": "modified",
        "D": "deleted",
        "R": "renamed",
        "C": "copied",
        "T": "type_changed",
    }
    for line in status_result.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) < 2:
            continue
        status_code = parts[0][0]
        path = parts[-1]
        additions, deletions = stats_by_path.get(path, (0, 0))
        changed_files.append(
            {
                "path": path,
                "status": status_map.get(status_code, "unknown"),
                "additions": additions,
                "deletions": deletions,
                "classifications": classify_path(path, status_code),
                "summary": f"{status_map.get(status_code, 'unknown')} file with {additions} additions and {deletions} deletions",
            }
        )

    total_files = len(changed_files)
    shown_files = changed_files[:limit]
    truncated = total_files > len(shown_files)
    return 0, {
        "schema_version": SCHEMA_VERSION,
        "repo": {
            "name": repo_root.name,
            "root": str(repo_root),
            "remote": run_git(["remote", "get-url", "origin"], cwd=repo_root).stdout.strip() or None,
        },
        "range": {
            "expression": diff_range,
            "from_commit": diff_range.split("..", 1)[0] if ".." in diff_range else "",
            "to_commit": diff_range.split("..", 1)[1] if ".." in diff_range else "",
        },
        "produced_by_analyzer": {
            "id": "repo-review-cli",
            "kind": "tool",
            "model": None,
            "tool_context": "repo-review diff",
        },
        "summary_stats": {
            "files_changed": total_files,
            "additions": sum(file["additions"] for file in changed_files),
            "deletions": sum(file["deletions"] for file in changed_files),
        },
        "changed_files": shown_files,
        "truncation": {
            "limit": limit,
            "shown": len(shown_files),
            "total": total_files,
            "truncated": truncated,
            "narrowing_hints": ["Use --path <path> to filter changed files.", "Use --limit <n> to raise or lower the bound."] if truncated else [],
        },
        "unknowns": [],
    }


ARTIFACT_KIND_REQUIREMENTS = {
    "review-state": ["id", "claims"],
    "diff-report": ["range", "changed_files"],
    "impact-plan": ["from_review", "impacted_claims"],
}


def artifact_kind_for_label(label: str) -> str:
    return label.split(" ", 1)[0]


def load_json_file(path_value: str | None, label: str) -> tuple[dict[str, Any] | None, int]:
    artifact_kind = artifact_kind_for_label(label)
    if not path_value:
        return None, fail(
            f"missing required --{label}",
            f"Run with --{label} <path>.",
            valid_values=[f"--{label}"],
            expected_artifact_kind=artifact_kind,
        )
    path = Path(path_value)
    if not path.is_file():
        return None, fail(
            f"{label} file was not found",
            f"Expected a readable JSON file at {path}.",
            code=4,
            error_code="resource_not_found",
            path=str(path),
            expected_artifact_kind=artifact_kind,
        )
    try:
        with path.open(encoding="utf-8") as handle:
            payload = json.load(handle)
    except json.JSONDecodeError as exc:
        return None, fail(
            f"{label} is not valid JSON",
            f"{exc.msg} at line {exc.lineno}, column {exc.colno}.",
            code=3,
            error_code="validation_failed",
            path=str(path),
            expected_artifact_kind=artifact_kind,
        )
    if not isinstance(payload, dict):
        return None, fail(
            f"{label} file has wrong artifact kind",
            f"Expected {artifact_kind} JSON object.",
            code=3,
            error_code="validation_failed",
            valid_values=[artifact_kind],
            path=str(path),
            expected_artifact_kind=artifact_kind,
        )
    required_keys = ARTIFACT_KIND_REQUIREMENTS.get(artifact_kind, [])
    missing = [key for key in required_keys if key not in payload]
    if missing:
        return None, fail(
            f"{label} file has wrong artifact kind",
            f"Expected {artifact_kind} JSON with fields: {', '.join(required_keys)}.",
            code=3,
            error_code="validation_failed",
            valid_values=[artifact_kind],
            path=str(path),
            expected_artifact_kind=artifact_kind,
        )
    return payload, 0


def parse_scalar(value: str) -> Any:
    value = value.strip()
    if value == "null":
        return None
    if value == "true":
        return True
    if value == "false":
        return False
    if value.startswith("[") and value.endswith("]"):
        inner = value[1:-1].strip()
        if not inner:
            return []
        return [parse_scalar(part.strip()) for part in inner.split(",")]
    return value.strip('"').strip("'")


def extract_yaml_block(text: str, top_key: str) -> str | None:
    blocks = re.findall(r"```ya?ml\n(.*?)\n```", text, flags=re.DOTALL)
    for block in reversed(blocks):
        if re.search(rf"^{re.escape(top_key)}:\s*$", block, flags=re.MULTILINE):
            return block
    return None


def parse_yaml_subset(block: str) -> dict[str, Any]:
    root: dict[str, Any] = {}
    stack: list[tuple[int, dict[str, Any]]] = [(-1, root)]
    lines = block.splitlines()
    index = 0

    while index < len(lines):
        raw = lines[index]
        index += 1
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        indent = len(raw) - len(raw.lstrip(" "))
        line = raw.strip()
        if line.startswith("- "):
            continue
        if ":" not in line:
            continue

        key, value = line.split(":", 1)
        key = key.strip()
        value = value.strip()
        while stack and indent <= stack[-1][0]:
            stack.pop()
        parent = stack[-1][1]

        if value == "|":
            block_lines: list[str] = []
            while index < len(lines):
                next_raw = lines[index]
                next_indent = len(next_raw) - len(next_raw.lstrip(" "))
                if next_raw.strip() and next_indent <= indent:
                    break
                block_lines.append(next_raw[indent + 2 :] if len(next_raw) > indent + 2 else "")
                index += 1
            parent[key] = "\n".join(block_lines).strip()
            continue

        if value:
            parent[key] = parse_scalar(value)
            continue

        child: dict[str, Any] = {}
        parent[key] = child
        stack.append((indent, child))

    return root


def extract_unfenced_yaml_block(text: str, top_key: str) -> str | None:
    lines = text.splitlines()
    for index, line in enumerate(lines):
        if re.match(rf"^{re.escape(top_key)}:\s*$", line):
            return "\n".join(lines[index:])
    return None


def yaml_scalar_value(block: str, key: str) -> str | None:
    match = re.search(rf"^\s+{re.escape(key)}:\s*(.+?)\s*$", block, flags=re.MULTILINE)
    if not match:
        return None
    value = match.group(1).strip()
    if value in {"[]", "{}"}:
        return ""
    return value.strip('"').strip("'")


def yaml_list_items(block: str, key: str) -> tuple[list[dict[str, Any]], bool]:
    lines = block.splitlines()
    for index, line in enumerate(lines):
        match = re.match(rf"^(\s+){re.escape(key)}:\s*(.*)$", line)
        if not match:
            continue
        key_indent = len(match.group(1))
        inline_value = match.group(2).strip()
        if inline_value == "[]":
            return [], True
        if inline_value:
            return [], False
        items: list[dict[str, Any]] = []
        item: dict[str, Any] | None = None
        for child in lines[index + 1 :]:
            if not child.strip():
                continue
            indent = len(child) - len(child.lstrip(" "))
            if indent <= key_indent:
                break
            stripped = child.strip()
            if stripped.startswith("- "):
                if item is not None:
                    items.append(item)
                item = {}
                remainder = stripped[2:].strip()
                if remainder:
                    if ":" in remainder:
                        item_key, item_value = remainder.split(":", 1)
                        item[item_key.strip()] = parse_scalar(item_value.strip())
                    else:
                        item["text"] = remainder
                continue
            if item is not None and ":" in stripped:
                item_key, item_value = stripped.split(":", 1)
                item[item_key.strip()] = parse_scalar(item_value.strip())
        if item is not None:
            items.append(item)
        return items, True
    return [], True


def extract_frontmatter(text: str) -> dict[str, Any]:
    if not text.startswith("---\n"):
        return {}
    marker = text.find("\n---", 4)
    if marker == -1:
        return {}
    return parse_yaml_subset(text[4:marker])


def iso_now() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat()


def parse_datetime_value(value: str) -> datetime | None:
    try:
        normalized = value.replace("Z", "+00:00")
        parsed = datetime.fromisoformat(normalized)
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed


def datetime_from_date(date_value: str) -> str:
    parsed = datetime.fromisoformat(date_value).replace(tzinfo=timezone.utc)
    return parsed.isoformat()


def find_iso_date(value: str | None) -> str | None:
    if not value:
        return None
    match = re.search(r"\d{4}-\d{2}-\d{2}", value)
    return match.group(0) if match else None


def repo_metadata(repo_path: Path) -> tuple[dict[str, Any] | None, dict[str, Any] | None]:
    if not repo_path.exists():
        return None, {
            "message": "repo path was not found",
            "hint": f"Expected a git checkout at {repo_path}.",
            "code": 4,
        }
    root_result = run_git(["rev-parse", "--show-toplevel"], cwd=repo_path)
    if root_result.returncode != 0:
        return None, {
            "message": "repo path is not a git checkout",
            "hint": "Pass --repo <path> pointing at a git repository.",
            "code": 4,
        }
    root = Path(root_result.stdout.strip())
    commit_result = run_git(["rev-parse", "HEAD"], cwd=root)
    if commit_result.returncode != 0:
        return None, {
            "message": "git rev-parse HEAD failed",
            "hint": commit_result.stderr.strip() or "Check that the repository has a commit.",
            "code": 6,
        }
    remote_result = run_git(["remote", "get-url", "origin"], cwd=root)
    return {
        "name": root.name,
        "root": str(root),
        "remote": remote_result.stdout.strip() if remote_result.returncode == 0 and remote_result.stdout.strip() else None,
        "commit": commit_result.stdout.strip(),
    }, None


def source_identity(options: dict[str, Any]) -> tuple[dict[str, Any], list[str]]:
    warnings: list[str] = []
    source_id = options.get("source_analyzer_id")
    if source_id:
        kind = options.get("source_kind") or "unknown"
        if kind not in ENUMS["analyzer_kind"]:
            warnings.append(f"Unknown source kind {kind!r}; using 'unknown'.")
            kind = "unknown"
        return {
            "id": source_id,
            "kind": kind,
            "model": options.get("source_model"),
            "tool_context": options.get("source_tool_context") or "pre-bootstrap review",
            "prompt_set_version": options.get("source_prompt_set_version") or "repo-review-pre-v1",
            "notes": options.get("source_notes") or "Original prose reviewer supplied during bootstrap.",
        }, warnings
    warnings.append("Original reviewer identity was not supplied; using unknown-pre-bootstrap.")
    return {
        "id": "unknown-pre-bootstrap",
        "kind": "unknown",
        "model": None,
        "tool_context": "pre-bootstrap review",
        "prompt_set_version": "repo-review-pre-v1",
        "notes": "Original prose reviewer was not supplied during bootstrap.",
    }, warnings


def infer_pass_id(path: Path, text: str) -> tuple[str, str, list[str], str]:
    warnings: list[str] = []
    block = extract_yaml_block(text, "pass_output")
    if block:
        parsed = parse_yaml_subset(block).get("pass_output", {})
        pass_id = parsed.get("pass_id") if isinstance(parsed, dict) else None
        if pass_id:
            return str(pass_id), "pass_output.pass_id", warnings, "prose-with-yaml-appendix"

    frontmatter = extract_frontmatter(text)
    if frontmatter.get("pass_id"):
        return str(frontmatter["pass_id"]), "frontmatter.pass_id", warnings, "prose" if not block else "prose-with-yaml-appendix"

    stem = path.stem.lower()
    patterns = [
        ("first-read", "first-read"),
        ("discounted-artifact", "discounted-artifact"),
        ("trace", "trace"),
        ("twin", "twin"),
        ("lift-addendum", "lift-addendum"),
        ("lift", "lift"),
        ("synthesis", "synthesis"),
    ]
    for needle, pass_id in patterns:
        if needle in stem:
            warnings.append(f"Pass id inferred from filename pattern: {pass_id}.")
            return pass_id, "filename-pattern", warnings, "prose" if not block else "prose-with-yaml-appendix"
    if stem.startswith("03-"):
        warnings.append("Pass id inferred from 03-* filename pattern: synthesis.")
        return "synthesis", "filename-pattern", warnings, "prose" if not block else "prose-with-yaml-appendix"
    if stem.startswith("06-"):
        warnings.append("Pass id inferred from 06-* filename pattern: lift-addendum.")
        return "lift-addendum", "filename-pattern", warnings, "prose" if not block else "prose-with-yaml-appendix"

    fallback = re.sub(r"[^a-z0-9_.:-]+", "-", stem).strip("-") or "review"
    warnings.append(f"Pass id conservatively inferred from filename stem: {fallback}.")
    return fallback, "filename-stem", warnings, "prose" if not block else "prose-with-yaml-appendix"


def relative_to_state(path: Path, state_path: Path) -> str:
    try:
        return os.path.relpath(path.resolve(), state_path.parent.resolve())
    except ValueError:
        return str(path.resolve())


def discover_review_artifacts(review_dir: Path, output_path: Path) -> tuple[list[dict[str, Any]], list[str], int | None, list[dict[str, Any]]]:
    discovered: list[dict[str, Any]] = []
    warnings: list[str] = []
    ambiguities: list[dict[str, Any]] = []
    mtimes: list[int] = []
    if not review_dir.is_dir():
        return discovered, [f"Review directory was not found: {review_dir}"], None, ambiguities
    for path in sorted(review_dir.rglob("*.md")):
        if path.name.startswith("."):
            continue
        text = path.read_text(encoding="utf-8")
        pass_id, source, file_warnings, output_kind = infer_pass_id(path, text)
        mtimes.append(int(path.stat().st_mtime))
        item = {
            "path": relative_to_state(path, output_path),
            "absolute_path": str(path.resolve()),
            "pass_id": pass_id,
            "pass_id_source": source,
            "output_kind": output_kind,
            "warnings": file_warnings,
        }
        discovered.append(item)
        warnings.extend(f"{path.name}: {warning}" for warning in file_warnings)
        if output_kind == "prose":
            warnings.append(f"{path.name}: no structured pass_output appendix found.")

    by_pass_id: dict[str, list[dict[str, Any]]] = {}
    for item in discovered:
        by_pass_id.setdefault(item["pass_id"], []).append(item)
    for pass_id, items in sorted(by_pass_id.items()):
        if len(items) <= 1:
            continue
        paths = [item["path"] for item in items]
        message = f"Multiple discovered files resolve to pass_id {pass_id!r}; explicit output selection may be required."
        ambiguities.append(
            {
                "kind": "duplicate_pass_id",
                "pass_id": pass_id,
                "files": paths,
                "message": message,
            }
        )
        warnings.append(message)
        for item in items:
            item.setdefault("warnings", []).append(message)

    return discovered, warnings, min(mtimes) if mtimes else None, ambiguities


def infer_created_at(options: dict[str, Any], output_path: Path, review_state_id: str, oldest_mtime: int | None) -> tuple[str, list[str]]:
    warnings: list[str] = []
    if options.get("created_at"):
        parsed = parse_datetime_value(options["created_at"])
        if parsed is None:
            warnings.append("--created-at was not valid ISO-8601; using current bootstrap time.")
            return iso_now(), warnings
        return parsed.isoformat(), warnings
    date_value = find_iso_date(review_state_id) or find_iso_date(str(output_path))
    if date_value:
        return datetime_from_date(date_value), warnings
    if oldest_mtime is not None:
        warnings.append("Original review date inferred from oldest discovered file mtime.")
        return datetime.fromtimestamp(oldest_mtime, tz=timezone.utc).replace(microsecond=0).isoformat(), warnings
    warnings.append("Original review date unknown; using current bootstrap time.")
    return iso_now(), warnings


def atomic_write_json(path: Path, payload: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temp_path = path.with_name(path.name + ".tmp")
    with temp_path.open("w", encoding="utf-8") as handle:
        json.dump(payload, handle, indent=2, sort_keys=True)
        handle.write("\n")
    temp_path.replace(path)


def validate_analyzer(analyzer: Any, label: str) -> list[str]:
    errors: list[str] = []
    if not isinstance(analyzer, dict):
        return [f"{label} must be an object."]
    for key in ("id", "kind", "model", "tool_context"):
        if key not in analyzer:
            errors.append(f"{label}.{key} is required.")
    if analyzer.get("kind") not in ENUMS["analyzer_kind"]:
        errors.append(f"{label}.kind must be one of {', '.join(ENUMS['analyzer_kind'])}.")
    if not analyzer.get("id"):
        errors.append(f"{label}.id must be non-empty.")
    if not analyzer.get("tool_context"):
        errors.append(f"{label}.tool_context must be non-empty.")
    return errors


def validate_claim_shape(claim: Any, label: str, require_identity: bool = True) -> list[str]:
    errors: list[str] = []
    if not isinstance(claim, dict):
        return [f"{label} must be an object."]
    required = [
        "id",
        "kind",
        "subject",
        "statement",
        "evidence_refs",
        "confidence",
        "claim_status",
        "depends_on_claims",
        "related_claims",
        "watch_paths",
        "invalidation_triggers",
        "contested_by",
    ]
    if require_identity:
        required.append("produced_by_analyzer")
    for key in required:
        if key not in claim:
            errors.append(f"{label}.{key} is required.")
    if claim.get("confidence") not in ENUMS["confidence"]:
        errors.append(f"{label}.confidence must be one of {', '.join(ENUMS['confidence'])}.")
    if claim.get("claim_status") not in ENUMS["claim_status"]:
        errors.append(f"{label}.claim_status must be one of {', '.join(ENUMS['claim_status'])}.")
    subject = claim.get("subject")
    if not isinstance(subject, dict) or not subject.get("type") or not subject.get("ref"):
        errors.append(f"{label}.subject must include type and ref.")
    for key in ("evidence_refs", "depends_on_claims", "related_claims", "watch_paths", "invalidation_triggers", "contested_by"):
        if key in claim and not isinstance(claim[key], list):
            errors.append(f"{label}.{key} must be an array.")
    if "produced_by_analyzer" in claim:
        errors.extend(validate_analyzer(claim["produced_by_analyzer"], f"{label}.produced_by_analyzer"))
    return errors


def validate_delta_review_artifact_shape(artifact: Any) -> list[str]:
    errors: list[str] = []
    if not isinstance(artifact, dict):
        return ["delta-review artifact must be an object."]
    for key in ("schema_version", "kind", "delta_review"):
        if key not in artifact:
            errors.append(f"{key} is required.")
    if artifact.get("schema_version") != SCHEMA_VERSION:
        errors.append("schema_version must be 1.")
    if artifact.get("kind") != "delta-review":
        errors.append("kind must be delta-review.")

    block = artifact.get("delta_review")
    if not isinstance(block, dict):
        errors.append("delta_review must be an object.")
        return errors

    for key in ("summary", "candidate_claims", "drift", "warnings"):
        if key not in block:
            errors.append(f"delta_review.{key} is required.")
    if "summary" in block and not isinstance(block["summary"], str):
        errors.append("delta_review.summary must be a string.")
    for key in ("candidate_claims", "drift", "warnings"):
        if key in block and not isinstance(block[key], list):
            errors.append(f"delta_review.{key} must be an array.")
    for index, item in enumerate(block.get("candidate_claims", []) if isinstance(block.get("candidate_claims"), list) else []):
        if not isinstance(item, (dict, str)):
            errors.append(f"delta_review.candidate_claims[{index}] must be an object or prose string.")
    for index, item in enumerate(block.get("drift", []) if isinstance(block.get("drift"), list) else []):
        if not isinstance(item, (dict, str)):
            errors.append(f"delta_review.drift[{index}] must be an object or prose string.")
    for index, item in enumerate(block.get("warnings", []) if isinstance(block.get("warnings"), list) else []):
        if not isinstance(item, (dict, str)):
            errors.append(f"delta_review.warnings[{index}] must be an object or prose string.")
    if "metadata" in block and not isinstance(block["metadata"], dict):
        errors.append("delta_review.metadata must be an object.")
    return errors


def validate_review_state_shape(state: Any) -> list[str]:
    errors: list[str] = []
    if not isinstance(state, dict):
        return ["review state must be an object."]
    for key in ("schema_version", "id", "repo", "mode", "created_at", "produced_by_analyzer", "pass_outputs", "claims", "drift_surface", "limits"):
        if key not in state:
            errors.append(f"{key} is required.")
    if state.get("schema_version") != SCHEMA_VERSION:
        errors.append("schema_version must be 1.")
    if state.get("mode") not in ENUMS["review_mode"]:
        errors.append("mode must be full or delta.")
    errors.extend(validate_analyzer(state.get("produced_by_analyzer"), "produced_by_analyzer"))
    repo = state.get("repo")
    if not isinstance(repo, dict) or not all(repo.get(key) for key in ("name", "root", "commit")) or "remote" not in repo:
        errors.append("repo must include name, root, remote, and commit.")
    for index, output in enumerate(state.get("pass_outputs", []) if isinstance(state.get("pass_outputs"), list) else []):
        label = f"pass_outputs[{index}]"
        if not isinstance(output, dict):
            errors.append(f"{label} must be an object.")
            continue
        for key in ("pass_id", "path", "output_kind", "produced_by_analyzer"):
            if key not in output:
                errors.append(f"{label}.{key} is required.")
        errors.extend(validate_analyzer(output.get("produced_by_analyzer"), f"{label}.produced_by_analyzer"))
    if not isinstance(state.get("claims"), list):
        errors.append("claims must be an array.")
    else:
        for index, claim in enumerate(state["claims"]):
            errors.extend(validate_claim_shape(claim, f"claims[{index}]", require_identity=True))
    if not isinstance(state.get("limits"), list):
        errors.append("limits must be an array.")
    return errors


def migrate_review_run_record(record: Any) -> tuple[dict[str, Any] | None, list[str]]:
    if not isinstance(record, dict):
        return None, ["review run must be an object."]
    schema_version = record.get("schema_version")
    if schema_version == REVIEW_RUN_SCHEMA_VERSION:
        return dict(record), []
    if schema_version == 0:
        migrated = dict(record)
        migrated["schema_version"] = REVIEW_RUN_SCHEMA_VERSION
        migrated.setdefault("range", None)
        migrated.setdefault("prior_review_state", None)
        migrated.setdefault("artifacts", {})
        migrated.setdefault("human_decisions", [])
        migrated.setdefault("warnings", [])
        repo = dict(migrated.get("repo") or {})
        repo.setdefault("remote", None)
        migrated["repo"] = repo
        return migrated, []
    if isinstance(schema_version, int) and schema_version > REVIEW_RUN_SCHEMA_VERSION:
        return None, [
            f"review run schema_version {schema_version} is newer than this CLI supports; upgrade repo-review before reading this run ledger."
        ]
    return None, [f"review run schema_version must be {REVIEW_RUN_SCHEMA_VERSION}."]


def validate_review_run_shape(record: Any) -> list[str]:
    migrated, migration_errors = migrate_review_run_record(record)
    if migration_errors:
        return migration_errors
    assert migrated is not None
    errors: list[str] = []
    required = (
        "schema_version",
        "run_id",
        "mode",
        "status",
        "repo",
        "range",
        "prior_review_state",
        "output_dir",
        "artifacts",
        "human_decisions",
        "warnings",
        "created_at",
        "updated_at",
    )
    for key in required:
        if key not in migrated:
            errors.append(f"missing required field: {key}.")
    if migrated.get("mode") not in {"full", "delta", "bootstrap"}:
        errors.append("mode must be one of: full, delta, bootstrap.")
    if migrated.get("status") not in REVIEW_RUN_STATUSES:
        errors.append(f"status must be one of: {', '.join(REVIEW_RUN_STATUSES)}.")
    repo = migrated.get("repo")
    if not isinstance(repo, dict):
        errors.append("repo must be an object.")
    else:
        for key in ("name", "root", "remote", "commit"):
            if key not in repo:
                errors.append(f"repo.{key} is required.")
    if not isinstance(migrated.get("artifacts"), dict):
        errors.append("artifacts must be an object.")
    if not isinstance(migrated.get("human_decisions"), list):
        errors.append("human_decisions must be an array.")
    if not isinstance(migrated.get("warnings"), list):
        errors.append("warnings must be an array.")
    for key in ("run_id", "output_dir", "created_at", "updated_at"):
        if not isinstance(migrated.get(key), str) or not migrated.get(key):
            errors.append(f"{key} must be a non-empty string.")
    return errors


def review_run_ledger_path(repo_root: Path) -> Path:
    return repo_root / ".repo-review" / "runs.jsonl"


def read_review_run_ledger(repo_root: Path) -> tuple[list[dict[str, Any]], list[str]]:
    path = review_run_ledger_path(repo_root)
    if not path.exists():
        return [], []
    records: list[dict[str, Any]] = []
    errors: list[str] = []
    with path.open(encoding="utf-8") as handle:
        for line_number, line in enumerate(handle, start=1):
            raw = line.strip()
            if not raw:
                continue
            try:
                loaded = json.loads(raw)
            except json.JSONDecodeError as exc:
                errors.append(f"{path}: line {line_number} is not valid JSON: {exc.msg}.")
                continue
            migrated, migration_errors = migrate_review_run_record(loaded)
            if migration_errors:
                errors.extend(f"{path}: line {line_number}: {error}" for error in migration_errors)
                continue
            assert migrated is not None
            validation_errors = validate_review_run_shape(migrated)
            if validation_errors:
                errors.extend(f"{path}: line {line_number}: {error}" for error in validation_errors)
                continue
            records.append(migrated)
    return records, errors


def latest_review_runs(records: list[dict[str, Any]]) -> dict[str, dict[str, Any]]:
    latest: dict[str, dict[str, Any]] = {}
    for record in records:
        latest[record["run_id"]] = record
    return latest


def get_review_run_record(repo_root: Path, run_id: str) -> tuple[dict[str, Any] | None, list[str]]:
    records, errors = read_review_run_ledger(repo_root)
    if errors:
        return None, errors
    return latest_review_runs(records).get(run_id), []


def append_review_run_record(repo_root: Path, record: dict[str, Any]) -> tuple[dict[str, Any] | None, list[str]]:
    migrated, migration_errors = migrate_review_run_record(record)
    if migration_errors:
        return None, migration_errors
    assert migrated is not None
    validation_errors = validate_review_run_shape(migrated)
    if validation_errors:
        return None, validation_errors
    path = review_run_ledger_path(repo_root)
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(migrated, sort_keys=True) + "\n")
    return migrated, []


def write_review_run_ledger(repo_root: Path, records: list[dict[str, Any]]) -> list[str]:
    for index, record in enumerate(records):
        validation_errors = validate_review_run_shape(record)
        if validation_errors:
            return [f"records[{index}]: {error}" for error in validation_errors]
    path = review_run_ledger_path(repo_root)
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w", encoding="utf-8") as handle:
        for record in records:
            handle.write(json.dumps(record, sort_keys=True) + "\n")
    return []


def update_review_run_record(repo_root: Path, run_id: str, updates: dict[str, Any], updated_at: str | None = None) -> tuple[dict[str, Any] | None, list[str]]:
    current, errors = get_review_run_record(repo_root, run_id)
    if errors:
        return None, errors
    if current is None:
        return None, [f"review run '{run_id}' was not found in {review_run_ledger_path(repo_root)}."]
    updated = {**current, **updates, "run_id": run_id, "updated_at": updated_at or utc_now()}
    return append_review_run_record(repo_root, updated)


def summarize_run(record: dict[str, Any]) -> dict[str, Any]:
    return {
        "run_id": record.get("run_id"),
        "mode": record.get("mode"),
        "status": record.get("status"),
        "repo": record.get("repo"),
        "range": record.get("range"),
        "output_dir": record.get("output_dir"),
        "updated_at": record.get("updated_at"),
        "next_action": review_run_next_action(record.get("status")),
    }


def runs_command(positionals: list[str], options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    if not positionals:
        return fail("missing runs subcommand", "Use one of: list, get, prune.", valid_values=["list", "get", "prune"]), None
    subcommand, *rest = positionals
    repo_root = Path(options.get("repo") or ROOT).expanduser().resolve()
    ledger = review_run_ledger_path(repo_root)

    if subcommand == "list":
        records, errors = read_review_run_ledger(repo_root)
        if errors:
            return fail("run ledger is invalid", errors[0], code=3, error_code="validation_failed", path=str(ledger)), None
        try:
            limit = int(options.get("limit") or 20)
        except (TypeError, ValueError):
            return fail("invalid --limit", "Use a positive integer for --limit.", valid_values=["1", "20", "50"]), None
        if limit < 1:
            return fail("invalid --limit", "Use a positive integer for --limit.", valid_values=["1", "20", "50"]), None
        latest = sorted(latest_review_runs(records).values(), key=lambda item: item.get("updated_at", ""), reverse=True)
        shown = latest[:limit]
        return 0, {
            "schema_version": SCHEMA_VERSION,
            "action": "list",
            "repo_root": str(repo_root),
            "ledger": str(ledger),
            "runs": [summarize_run(record) for record in shown],
            "truncation": {
                "limit": limit,
                "shown": len(shown),
                "total": len(latest),
                "truncated": len(latest) > len(shown),
            },
        }

    if subcommand == "get":
        run_id = options.get("run") or (rest[0] if rest else None)
        if not run_id:
            return fail("missing run id", "Run: repo-review runs get <run-id> --json --no-input", valid_values=["--run"]), None
        record, errors = get_review_run_record(repo_root, run_id)
        if errors:
            return fail("run ledger is invalid", errors[0], code=3, error_code="validation_failed", path=str(ledger)), None
        if record is None:
            return fail(
                "review run was not found",
                f"No run '{run_id}' exists in {ledger}.",
                code=4,
                error_code="resource_not_found",
                path=str(ledger),
            ), None
        return 0, {
            "schema_version": SCHEMA_VERSION,
            "action": "get",
            "repo_root": str(repo_root),
            "ledger": str(ledger),
            "run": record,
            "next_action": review_run_next_action(record["status"]),
        }

    if subcommand == "prune":
        records, errors = read_review_run_ledger(repo_root)
        if errors:
            return fail("run ledger is invalid", errors[0], code=3, error_code="validation_failed", path=str(ledger)), None
        latest = latest_review_runs(records)
        keep: list[dict[str, Any]] = []
        pruned_count = 0
        for record in records:
            latest_record = latest[record["run_id"]]
            if latest_record.get("status") == "complete" and record is not latest_record:
                pruned_count += 1
            else:
                keep.append(record)
        dry_run = bool(options.get("dry_run"))
        if not dry_run and not options.get("force"):
            return fail(
                "unsafe prune refused",
                "Run with --dry-run to inspect candidates or add --force to rewrite the run ledger.",
                code=5,
                error_code="unsafe_mutation_refused",
                valid_values=["--dry-run", "--force"],
            ), None
        if not dry_run:
            errors = write_review_run_ledger(repo_root, keep)
            if errors:
                return fail("run ledger rewrite failed", errors[0], code=3, error_code="validation_failed", path=str(ledger)), None
        outcome = "dry_run" if dry_run else ("updated" if pruned_count else "unchanged")
        return 0, {
            "schema_version": SCHEMA_VERSION,
            "action": "prune",
            "repo_root": str(repo_root),
            "ledger": str(ledger),
            "dry_run": dry_run,
            "mutation_outcome": outcome,
            "records_before": len(records),
            "records_after": len(keep),
            "pruned_count": pruned_count,
            "kept_run_ids": sorted(latest),
        }

    return fail(f"unknown runs subcommand '{subcommand}'", "Use one of: list, get, prune.", valid_values=["list", "get", "prune"]), None


def review_run_next_action(status: str) -> dict[str, Any]:
    contract = REVIEW_RUN_STATUS_CONTRACTS.get(status)
    if contract is None:
        return {
            "status": status,
            "next_action": "Report invalid run status and inspect the run ledger.",
            "recommended_command": None,
        }
    return {
        "status": status,
        "meaning": contract["meaning"],
        "next_action": contract["next_action"],
        "recommended_command": contract["recommended_command"],
    }


def review_state_readiness_warnings(state: dict[str, Any]) -> list[str]:
    warnings: list[str] = []
    if not state.get("claims"):
        warnings.append("review state has no claims.")
    if not state.get("pass_outputs"):
        warnings.append("review state has no pass outputs.")
    for limit in state.get("limits", []) if isinstance(state.get("limits"), list) else []:
        warnings.append(f"limit: {limit}")
    return warnings


def summarize_review_state(state: dict[str, Any], path: Path, errors: list[str] | None = None) -> dict[str, Any]:
    validation_errors = errors if errors is not None else validate_review_state_shape(state)
    repo = state.get("repo") if isinstance(state.get("repo"), dict) else {}
    return {
        "id": state.get("id"),
        "path": str(path),
        "repo": repo,
        "mode": state.get("mode"),
        "created_at": state.get("created_at"),
        "claim_count": len(state.get("claims", [])) if isinstance(state.get("claims"), list) else 0,
        "pass_output_count": len(state.get("pass_outputs", [])) if isinstance(state.get("pass_outputs"), list) else 0,
        "valid": not validation_errors,
        "errors": validation_errors,
        "warnings": review_state_readiness_warnings(state) if not validation_errors else [],
    }


def review_state_matches_repo(state: dict[str, Any], repo_root: Path) -> bool:
    repo = state.get("repo")
    if not isinstance(repo, dict):
        return False
    root = repo.get("root")
    if root:
        try:
            if Path(root).expanduser().resolve() == repo_root:
                return True
        except OSError:
            pass
    return repo.get("name") == repo_root.name


def candidate_review_state_paths(repo_root: Path) -> list[Path]:
    roots = [repo_root / "reviews", ROOT / "reviews"]
    paths: list[Path] = []
    seen: set[Path] = set()
    for root in roots:
        if not root.is_dir():
            continue
        for path in root.rglob("review-state.json"):
            resolved = path.resolve()
            if resolved not in seen:
                seen.add(resolved)
                paths.append(resolved)
    return sorted(paths)


def discover_review_states(repo_root: Path) -> tuple[list[dict[str, Any]], list[str]]:
    states: list[dict[str, Any]] = []
    warnings: list[str] = []
    for path in candidate_review_state_paths(repo_root):
        try:
            with path.open(encoding="utf-8") as handle:
                loaded = json.load(handle)
        except json.JSONDecodeError as exc:
            warnings.append(f"{path}: not valid JSON: {exc.msg}.")
            continue
        if not isinstance(loaded, dict):
            warnings.append(f"{path}: review state must be an object.")
            continue
        if review_state_matches_repo(loaded, repo_root):
            states.append(summarize_review_state(loaded, path))
    states.sort(key=lambda item: (str(item.get("created_at") or ""), str(item.get("id") or "")), reverse=True)
    return states, warnings


def load_review_state_reference(reference: str, repo_root: Path) -> tuple[dict[str, Any] | None, Path | None, list[str]]:
    path = Path(reference).expanduser()
    if path.is_file():
        resolved = path.resolve()
        with resolved.open(encoding="utf-8") as handle:
            loaded = json.load(handle)
        if not isinstance(loaded, dict):
            return None, resolved, ["review state must be an object."]
        return loaded, resolved, []
    states, warnings = discover_review_states(repo_root)
    matches = [state for state in states if state.get("id") == reference]
    if len(matches) > 1:
        return None, None, [f"review state id '{reference}' is ambiguous; use a path."]
    if not matches:
        return None, None, [*warnings, f"review state '{reference}' was not found."]
    matched_path = Path(matches[0]["path"])
    with matched_path.open(encoding="utf-8") as handle:
        loaded = json.load(handle)
    if not isinstance(loaded, dict):
        return None, matched_path, ["review state must be an object."]
    return loaded, matched_path, warnings


def discover_candidate_claim_files(repo_root: Path, latest_state_id: str | None = None) -> list[dict[str, Any]]:
    roots = [repo_root / "reviews", ROOT / "reviews"]
    candidates: list[dict[str, Any]] = []
    seen: set[Path] = set()
    for root in roots:
        if not root.is_dir():
            continue
        for path in root.rglob("*.json"):
            name = path.name.lower()
            if "candidate" not in name or "claim" not in name:
                continue
            resolved = path.resolve()
            if resolved in seen:
                continue
            seen.add(resolved)
            try:
                with resolved.open(encoding="utf-8") as handle:
                    loaded = json.load(handle)
            except json.JSONDecodeError:
                continue
            if not isinstance(loaded, dict) or not isinstance(loaded.get("candidate_claims"), list):
                continue
            review_state_id = loaded.get("review_state")
            if latest_state_id and review_state_id not in {None, latest_state_id}:
                continue
            candidates.append(
                {
                    "path": str(resolved),
                    "review_state": review_state_id,
                    "candidate_claim_count": len(loaded["candidate_claims"]),
                }
            )
    return sorted(candidates, key=lambda item: item["path"])


def state_command(positionals: list[str], options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    if not positionals:
        return fail("missing state subcommand", "Use one of: bootstrap, list, latest, get, validate.", valid_values=["bootstrap", "list", "latest", "get", "validate"]), None
    subcommand = positionals[0]

    repo_root = Path(options.get("repo") or ROOT).expanduser().resolve()

    if subcommand == "list":
        states, warnings = discover_review_states(repo_root)
        return 0, {
            "schema_version": SCHEMA_VERSION,
            "action": "list",
            "repo_root": str(repo_root),
            "states": states,
            "warnings": warnings,
            "truncation": {"limit": len(states), "shown": len(states), "total": len(states), "truncated": False},
        }

    if subcommand == "latest":
        states, warnings = discover_review_states(repo_root)
        mode = options.get("mode")
        if mode:
            states = [state for state in states if state.get("mode") == mode]
        if not states:
            return fail(
                "review state was not found",
                "Run: repo-review state list --repo <path> --json --no-input, or create one with state bootstrap.",
                code=4,
                error_code="resource_not_found",
                valid_values=["state list", "state bootstrap"],
            ), None
        newest_created = states[0].get("created_at")
        tied = [state for state in states if state.get("created_at") == newest_created]
        if len(tied) > 1:
            return fail(
                "latest review state is ambiguous",
                "Use repo-review state list, then repo-review state get --review-state <id-or-path>.",
                code=2,
                error_code="invalid_invocation",
                valid_values=[str(state.get("id")) for state in tied if state.get("id")],
            ), None
        return 0, {
            "schema_version": SCHEMA_VERSION,
            "action": "latest",
            "repo_root": str(repo_root),
            "state": states[0],
            "valid": states[0]["valid"],
            "warnings": [*warnings, *states[0]["warnings"]],
            "errors": states[0]["errors"],
        }

    if subcommand in {"get", "validate"}:
        reference = options.get("review_state") or (positionals[1] if len(positionals) > 1 else None)
        if not reference:
            return fail(
                "missing required --review-state",
                f"Run: repo-review state {subcommand} --review-state <id-or-path> --json --no-input",
                valid_values=["--review-state"],
            ), None
        try:
            state, path, warnings = load_review_state_reference(reference, repo_root)
        except json.JSONDecodeError as exc:
            return fail("review state is not valid JSON", f"{exc.msg} at line {exc.lineno}, column {exc.colno}.", code=3, error_code="validation_failed"), None
        if state is None or path is None:
            return fail(
                "review state was not found",
                warnings[-1] if warnings else f"No review state matched {reference}.",
                code=4,
                error_code="resource_not_found",
                valid_values=["state list"],
            ), None
        summary = summarize_review_state(state, path)
        return 0, {
            "schema_version": SCHEMA_VERSION,
            "action": subcommand,
            "repo_root": str(repo_root),
            "state": summary,
            "review_state": state if subcommand == "get" else None,
            "valid": summary["valid"],
            "warnings": [*warnings, *summary["warnings"]],
            "errors": summary["errors"],
        }

    if subcommand != "bootstrap":
        return fail(f"unknown state subcommand '{subcommand}'", "Use one of: bootstrap, list, latest, get, validate.", valid_values=["bootstrap", "list", "latest", "get", "validate"]), None

    missing = [flag for flag in ("repo", "review_dir", "output") if not options.get(flag)]
    if missing:
        return fail(
            "missing required bootstrap input",
            "Run: repo-review state bootstrap --repo <path> --review-dir <path> --output <review-state.json> --json --no-input",
            valid_values=[f"--{flag.replace('_', '-')}" for flag in missing],
        ), None

    repo_path = Path(options["repo"]).expanduser().resolve()
    review_dir = Path(options["review_dir"]).expanduser().resolve()
    output_path = Path(options["output"]).expanduser().resolve()
    provenance_path = output_path.with_name("review-state.bootstrap.json")
    if not options.get("dry_run") and not options.get("overwrite"):
        existing = [str(path) for path in (output_path, provenance_path) if path.exists()]
        if existing:
            return fail(
                "output path already exists",
                "Add --overwrite to replace the existing review state or provenance sidecar.",
                code=5,
                error_code="unsafe_mutation_refused",
                valid_values=["--overwrite"],
            ), None

    repo, repo_error = repo_metadata(repo_path)
    if repo_error:
        return fail(repo_error["message"], repo_error["hint"], code=repo_error["code"], error_code="resource_not_found" if repo_error["code"] == 4 else "external_command_failed"), None
    assert repo is not None

    source, identity_warnings = source_identity(options)
    default_id_date = find_iso_date(str(output_path)) or datetime.now(timezone.utc).date().isoformat()
    review_state_id = options.get("review_state_id") or f"{repo['name']}-full-{default_id_date}"
    discovered, discovery_warnings, oldest_mtime, ambiguities = discover_review_artifacts(review_dir, output_path)
    created_at, date_warnings = infer_created_at(options, output_path, review_state_id, oldest_mtime)
    warnings = [*identity_warnings, *discovery_warnings, *date_warnings]

    limits = [
        "converted-from-pre-cli-prose",
        "claims-not-extracted",
        "requires-claim-selection",
        "bootstrap-provenance-sidecar",
    ]
    if any(item["output_kind"] == "prose" for item in discovered):
        limits.append("some-pass-outputs-lack-structured-appendix")
    if any(item["pass_id_source"].startswith("filename") for item in discovered):
        limits.append("pass-order-inferred-from-filenames")
    if ambiguities:
        limits.append("ambiguous-pass-output-selection")
    if source["id"] == "unknown-pre-bootstrap":
        limits.append("source-reviewer-identity-unknown")
    if any("Original review date unknown" in warning for warning in warnings):
        limits.append("original-review-date-unknown")

    state = {
        "schema_version": SCHEMA_VERSION,
        "id": review_state_id,
        "repo": repo,
        "mode": "full",
        "created_at": created_at,
        "produced_by_analyzer": source,
        "pass_outputs": [
            {
                "pass_id": item["pass_id"],
                "path": item["path"],
                "output_kind": item["output_kind"],
                "produced_by_analyzer": source,
            }
            for item in discovered
        ],
        "claims": [],
        "drift_surface": None,
        "limits": limits,
    }
    validation_errors = validate_review_state_shape(state)
    if validation_errors:
        return fail(
            "generated review state is invalid",
            "; ".join(validation_errors),
            code=3,
            error_code="validation_failed",
        ), None

    provenance = {
        "schema_version": SCHEMA_VERSION,
        "review_state": review_state_id,
        "created_at": iso_now(),
        "bootstrap_tool": {
            "id": "repo-review-cli",
            "kind": "tool",
            "model": None,
            "tool_context": "repo-review state bootstrap",
        },
        "source_identity": source,
        "inputs": {
            "repo": str(repo_path),
            "review_dir": str(review_dir),
            "output": str(output_path),
        },
        "discovered_files": discovered,
        "ambiguities": ambiguities,
        "warnings": warnings,
    }

    if not options.get("dry_run"):
        atomic_write_json(output_path, state)
        atomic_write_json(provenance_path, provenance)

    next_commands = [
        f"repo-review aggregate --review-state {output_path} --json --no-input",
        f"repo-review claims list --review-state {output_path} --json --no-input",
        f"repo-review diff --repo {repo['root']} --range <from>..<to> --json --no-input",
    ]
    payload = {
        "schema_version": SCHEMA_VERSION,
        "created": not bool(options.get("dry_run")),
        "dry_run": bool(options.get("dry_run")),
        "output": str(output_path),
        "provenance": str(provenance_path),
        "review_state_id": review_state_id,
        "pass_outputs": len(discovered),
        "claims": 0,
        "discovered_files": discovered,
        "ambiguities": ambiguities,
        "warnings": warnings,
        "next_commands": next_commands,
    }
    return 0, payload


def option_values(options: dict[str, Any], key: str) -> list[str]:
    value = options.get(key)
    if value in (None, ""):
        return []
    if isinstance(value, list):
        return [item for item in value if item not in (None, "")]
    return [value]


def add_count(counts: dict[str, int], key: str | None) -> None:
    counts[key or "unknown"] = counts.get(key or "unknown", 0) + 1


def path_matches(pattern: str, path: str) -> bool:
    if fnmatch(path, pattern):
        return True
    if "*" not in pattern and not pattern.endswith("/") and path.startswith(pattern.rstrip("/") + "/"):
        return True
    return False


def impact_command(options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    review_state, code = load_json_file(options.get("review_state"), "review-state")
    if code != 0:
        return code, None
    diff_report, code = load_json_file(options.get("diff_report"), "diff-report")
    if code != 0:
        return code, None
    assert review_state is not None
    assert diff_report is not None

    claims = review_state.get("claims", [])
    changed_files = diff_report.get("changed_files", [])
    path_hits: list[dict[str, Any]] = []
    impacted_ids: set[str] = set()
    matched_files: set[str] = set()

    for claim in claims:
        claim_id = claim.get("id")
        watch_paths = claim.get("watch_paths", [])
        matches: list[str] = []
        for changed in changed_files:
            changed_path = changed.get("path", "")
            if any(path_matches(pattern, changed_path) for pattern in watch_paths):
                matches.append(changed_path)
                matched_files.add(changed_path)
        if matches and claim_id:
            path_hits.append({"claim_id": claim_id, "matched_paths": sorted(set(matches))})
            impacted_ids.add(claim_id)

    trigger_hits = diff_report.get("trigger_hits", [])
    for hit in trigger_hits:
        claim_id = hit.get("claim_id")
        if claim_id:
            impacted_ids.add(claim_id)

    impacted_claims: list[dict[str, Any]] = []
    for claim_id in sorted(impacted_ids):
        surfaced_by = []
        if any(hit["claim_id"] == claim_id for hit in path_hits):
            surfaced_by.append("path_hit")
        if any(hit.get("claim_id") == claim_id for hit in trigger_hits):
            surfaced_by.append("trigger_hit")
        impacted_claims.append(
            {
                "claim_id": claim_id,
                "impact": "unknown",
                "surfaced_by": surfaced_by or ["unknown"],
                "reason": "Claim surfaced by " + ", ".join(surfaced_by or ["unknown mapping"]) + ".",
                "required_followup_passes": ["trace"],
            }
        )

    unaffected_claims = [
        {
            "claim_id": claim.get("id"),
            "reason": "No changed file matched watch_paths and no trigger hit was supplied.",
        }
        for claim in claims
        if claim.get("id") not in impacted_ids
    ]

    unknowns = list(diff_report.get("unknowns", []))
    for changed in changed_files:
        changed_path = changed.get("path")
        if changed_path and changed_path not in matched_files:
            unknowns.append(
                {
                    "changed_file": changed_path,
                    "classification": ",".join(changed.get("classifications", [])),
                    "reason": "No claim watch_path matched this changed file; semantic trigger evaluation may still be needed.",
                }
            )

    return 0, {
        "schema_version": SCHEMA_VERSION,
        "from_review": review_state.get("id"),
        "to_repo_commit": diff_report.get("range", {}).get("to_commit"),
        "diff_range": diff_report.get("range", {}).get("expression"),
        "path_hits": path_hits,
        "trigger_hits": trigger_hits,
        "impacted_claims": impacted_claims,
        "unaffected_claims": unaffected_claims,
        "unknowns": unknowns,
    }


def compact_json(data: dict[str, Any]) -> str:
    return json.dumps(data, indent=2, sort_keys=True)


def build_delta_prompt(review_state: dict[str, Any], diff_report: dict[str, Any], impact_plan: dict[str, Any]) -> str:
    impacted = impact_plan.get("impacted_claims", [])
    return "\n".join(
        [
            "# Delta Trace Prompt Packet",
            "",
            "You are updating an existing repo-review state. Do not rerun a full review.",
            "",
            "## Required Output",
            "",
            "- Include `produced_by_analyzer` with analyzer identity.",
            "- Update only claims surfaced by the impact plan unless new evidence requires a new claim.",
            "- Label each meaningful update as `subject_drift`, `analysis_drift`, or `both`.",
            "- Preserve contested or uncertain claims instead of silently adjudicating them.",
            "",
            "## Conflation Guard",
            "",
            "Keep intra-review delta, inter-version delta, analysis drift, and subject drift separate. A corrected interpretation of unchanged evidence is analysis drift, not proof that the repo changed.",
            "",
            "## Impact Summary",
            "",
            f"Impacted claims: {len(impacted)}",
            f"Unknowns: {len(impact_plan.get('unknowns', []))}",
            "",
            "## Prior Review State",
            "",
            "```json",
            compact_json(review_state),
            "```",
            "",
            "## Diff Report",
            "",
            "```json",
            compact_json(diff_report),
            "```",
            "",
            "## Impact Plan",
            "",
            "```json",
            compact_json(impact_plan),
            "```",
            "",
        ]
    )


def export_prompt_command(options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    pass_id = options.get("pass")
    if pass_id != "delta-trace":
        return fail(
            "unsupported or missing --pass",
            "Run: repo-review export-prompt --pass delta-trace --output <path> --json --no-input",
            valid_values=["delta-trace"],
        ), None
    deliver = options.get("deliver")
    output = options.get("output")
    if deliver:
        if deliver == "stdout":
            output = None
        elif deliver.startswith("file:"):
            output = deliver.removeprefix("file:")
            if not output:
                return fail("missing file delivery path", "Use --deliver=file:<path>.", valid_values=["file:<path>"]), None
        elif deliver.startswith("webhook:"):
            return fail(
                "webhook delivery is deferred in v1",
                "Use --deliver=stdout or --deliver=file:<path>.",
                code=2,
                valid_values=["stdout", "file:<path>"],
            ), None
        else:
            return fail("unsupported delivery scheme", "Use stdout or file:<path>.", valid_values=["stdout", "file:<path>"]), None
    if not output and deliver != "stdout":
        return fail("missing required --output", "Run with --output <path> or --deliver=stdout.", valid_values=["--output", "--deliver=stdout"]), None

    required_inputs = ["review-state", "diff-report", "impact-plan"]
    if options.get("dry_run"):
        return 0, {
            "schema_version": SCHEMA_VERSION,
            "dry_run": True,
            "would_write": None if deliver == "stdout" else str(Path(output)),
            "delivery": deliver or f"file:{output}",
            "delivery_metadata": {
                "scheme": "stdout" if deliver == "stdout" else "file",
                "path": None if deliver == "stdout" else str(Path(output)),
                "webhook_deferred": False,
            },
            "required_inputs": required_inputs,
            "missing_inputs": [name for name in required_inputs if not options.get(name.replace("-", "_"))],
        }

    review_state, code = load_json_file(options.get("review_state"), "review-state")
    if code != 0:
        return code, None
    diff_report, code = load_json_file(options.get("diff_report"), "diff-report")
    if code != 0:
        return code, None
    impact_plan, code = load_json_file(options.get("impact_plan"), "impact-plan")
    if code != 0:
        return code, None
    assert review_state is not None
    assert diff_report is not None
    assert impact_plan is not None

    prompt = build_delta_prompt(review_state, diff_report, impact_plan)
    if deliver == "stdout":
        return 0, {
            "schema_version": SCHEMA_VERSION,
            "delivery": "stdout",
            "delivery_metadata": {
                "scheme": "stdout",
                "path": None,
                "webhook_deferred": False,
            },
            "artifact": prompt,
            "bytes_written": 0,
            "pass": pass_id,
            "overwritten": False,
        }

    output_path = Path(output)
    if output_path.exists() and not options.get("overwrite"):
        return fail(
            "output path already exists",
            "Add --overwrite to replace the existing prompt packet.",
            code=5,
            error_code="unsafe_mutation_refused",
            valid_values=["--overwrite"],
        ), None
    output_path.parent.mkdir(parents=True, exist_ok=True)
    temp_path = output_path.with_suffix(output_path.suffix + ".tmp")
    temp_path.write_text(prompt, encoding="utf-8")
    temp_path.replace(output_path)
    return 0, {
        "schema_version": SCHEMA_VERSION,
        "path": str(output_path),
        "delivery": f"file:{output_path}",
        "delivery_metadata": {
            "scheme": "file",
            "path": str(output_path),
            "webhook_deferred": False,
        },
        "bytes_written": output_path.stat().st_size,
        "pass": pass_id,
        "overwritten": bool(options.get("overwrite")),
    }


def review_start_delta_command(options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    missing = [flag for flag in ("repo", "range", "review_state") if not options.get(flag)]
    if missing:
        return fail(
            "missing required review start input",
            "Run: repo-review review start --mode delta --repo <path> --range <from>..<to> --review-state <id-or-path> --json --no-input",
            valid_values=[f"--{flag.replace('_', '-')}" for flag in missing],
        ), None
    repo_root = Path(options["repo"]).expanduser().resolve()
    repo, repo_error = repo_metadata(repo_root)
    if repo_error:
        return fail(repo_error["message"], repo_error["hint"], code=repo_error["code"], error_code="resource_not_found" if repo_error["code"] == 4 else "external_command_failed"), None
    assert repo is not None
    review_state_ref = options["review_state"]
    if review_state_ref == "latest":
        states, _ = discover_review_states(repo_root)
        if not states:
            return fail("review state was not found", "Run state list or pass --review-state <path>.", code=4, error_code="resource_not_found"), None
        review_state_ref = states[0]["path"]
    try:
        review_state, review_state_path, warnings = load_review_state_reference(str(review_state_ref), repo_root)
    except json.JSONDecodeError as exc:
        return fail("review state is not valid JSON", f"{exc.msg} at line {exc.lineno}, column {exc.colno}.", code=3, error_code="validation_failed"), None
    if review_state is None or review_state_path is None:
        return fail("review state was not found", warnings[-1] if warnings else "Pass a valid --review-state path or ID.", code=4, error_code="resource_not_found"), None
    state_errors = validate_review_state_shape(review_state)
    if state_errors:
        return fail("review state is invalid", "; ".join(state_errors), code=3, error_code="validation_failed"), None

    diff_range = options["range"]
    natural_key = {
        "mode": "delta",
        "repo_root": str(repo_root),
        "range": diff_range,
        "review_state": str(review_state_path),
    }
    key_hash = hashlib.sha1(json.dumps(natural_key, sort_keys=True).encode("utf-8")).hexdigest()[:10]
    if options.get("new_run"):
        key_hash = hashlib.sha1(f"{key_hash}:{datetime.now(timezone.utc).isoformat()}".encode("utf-8")).hexdigest()[:10]
    run_id = f"{repo['name']}-delta-{datetime.now(timezone.utc).date().isoformat()}-{key_hash}"
    output_dir = Path(options.get("output") or (repo_root / "reviews" / repo["name"] / f"delta-{datetime.now(timezone.utc).date().isoformat()}-{key_hash}")).expanduser().resolve()
    diff_path = output_dir / "diff-report.json"
    impact_path = output_dir / "impact-plan.json"
    prompt_path = output_dir / "delta-trace-prompt.md"
    artifacts = {
        "diff_report": str(diff_path),
        "impact_plan": str(impact_path),
        "prompt_packet": str(prompt_path),
        "review_artifact": None,
        "drift_surface": None,
    }

    existing_runs, ledger_errors = read_review_run_ledger(repo_root)
    if ledger_errors:
        return fail("run ledger is invalid", ledger_errors[0], code=3, error_code="validation_failed", path=str(review_run_ledger_path(repo_root))), None
    duplicate = None
    if not options.get("new_run"):
        for run in latest_review_runs(existing_runs).values():
            if (
                run.get("mode") == "delta"
                and (run.get("repo") or {}).get("root") == str(repo_root)
                and run.get("range") == diff_range
                and run.get("prior_review_state") == str(review_state_path)
            ):
                duplicate = run
                break
    next_action = {
        "action": "send_prompt",
        "reason": "Prompt packet is ready for reviewer output.",
        "recommended_command": f"repo-review review ingest --run {duplicate['run_id'] if duplicate else run_id} --input <review.md> --json --no-input",
    }
    blocking_files = [str(path) for path in (diff_path, impact_path, prompt_path) if path.exists() and duplicate is None]
    if duplicate is not None:
        return 0, {
            "schema_version": SCHEMA_VERSION,
            "action": "start",
            "mode": "delta",
            "dry_run": bool(options.get("dry_run")),
            "mutation_outcome": "existing",
            "run": duplicate,
            "natural_key": natural_key,
            "artifacts": duplicate.get("artifacts", {}),
            "surface": {"impacted_claim_count": None, "unknown_count": None},
            "warnings": warnings,
            "next_action": next_action,
        }
    if options.get("dry_run"):
        run = {
            "schema_version": REVIEW_RUN_SCHEMA_VERSION,
            "run_id": run_id,
            "mode": "delta",
            "status": "created",
            "repo": repo,
            "range": diff_range,
            "prior_review_state": str(review_state_path),
            "output_dir": str(output_dir),
            "artifacts": artifacts,
            "human_decisions": [],
            "warnings": warnings,
            "created_at": iso_now(),
            "updated_at": iso_now(),
        }
        return 0, {
            "schema_version": SCHEMA_VERSION,
            "action": "start",
            "mode": "delta",
            "dry_run": True,
            "mutation_outcome": "dry_run",
            "run": run,
            "natural_key": natural_key,
            "would_read": [str(review_state_path), str(repo_root)],
            "would_write": [str(diff_path), str(impact_path), str(prompt_path), str(review_run_ledger_path(repo_root))],
            "blocking_files": blocking_files,
            "warnings": warnings,
            "next_action": {"action": "run_without_dry_run", "recommended_command": "repo-review review start --mode delta --repo <path> --range <from>..<to> --review-state <path> --json --no-input"},
        }
    if blocking_files:
        return fail(
            "review start would overwrite artifacts",
            "Choose a new --output directory or inspect the existing files.",
            code=5,
            error_code="unsafe_mutation_refused",
            valid_values=["--output", "--new-run"],
        ), None

    code, diff_report = diff_command({"repo": str(repo_root), "range": diff_range, "limit": "50"})
    if code != 0:
        return code, None
    assert diff_report is not None
    output_dir.mkdir(parents=True, exist_ok=True)
    atomic_write_json(diff_path, diff_report)
    code, impact_plan = impact_command({"review_state": str(review_state_path), "diff_report": str(diff_path)})
    if code != 0:
        return code, None
    assert impact_plan is not None
    atomic_write_json(impact_path, impact_plan)
    prompt_path.write_text(build_delta_prompt(review_state, diff_report, impact_plan), encoding="utf-8")
    timestamp = iso_now()
    run = {
        "schema_version": REVIEW_RUN_SCHEMA_VERSION,
        "run_id": run_id,
        "mode": "delta",
        "status": "prompt_ready",
        "repo": repo,
        "range": diff_range,
        "prior_review_state": str(review_state_path),
        "output_dir": str(output_dir),
        "artifacts": artifacts,
        "human_decisions": [],
        "warnings": warnings,
        "created_at": timestamp,
        "updated_at": timestamp,
    }
    saved, errors = append_review_run_record(repo_root, run)
    if errors:
        return fail("run record is invalid", "; ".join(errors), code=3, error_code="validation_failed"), None
    assert saved is not None
    return 0, {
        "schema_version": SCHEMA_VERSION,
        "action": "start",
        "mode": "delta",
        "dry_run": False,
        "mutation_outcome": "created",
        "run": saved,
        "natural_key": natural_key,
        "artifacts": artifacts,
        "surface": {
            "impacted_claim_count": len(impact_plan.get("impacted_claims", [])),
            "unknown_count": len(impact_plan.get("unknowns", [])),
        },
        "warnings": warnings,
        "next_action": next_action,
    }


def resolve_review_run(options: dict[str, Any]) -> tuple[dict[str, Any] | None, Path | None, list[str]]:
    repo_root = Path(options.get("repo") or ROOT).expanduser().resolve()
    records, errors = read_review_run_ledger(repo_root)
    if errors:
        return None, repo_root, errors
    latest = sorted(latest_review_runs(records).values(), key=lambda item: item.get("updated_at", ""), reverse=True)
    run_id = options.get("run")
    if run_id:
        for run in latest:
            if run.get("run_id") == run_id:
                return run, repo_root, []
        return None, repo_root, [f"review run '{run_id}' was not found in {review_run_ledger_path(repo_root)}."]
    if options.get("latest"):
        if not latest:
            return None, repo_root, [f"no review runs exist in {review_run_ledger_path(repo_root)}."]
        return latest[0], repo_root, []
    return None, repo_root, ["missing --run or --latest."]


def review_package_command(options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    run, repo_root, errors = resolve_review_run(options)
    assert repo_root is not None
    if errors:
        return fail("review run was not found", errors[0], code=4, error_code="resource_not_found", valid_values=["--run", "--latest"]), None
    assert run is not None
    if run.get("status") not in {"impact_ready", "prompt_ready"}:
        return fail(
            "run is not ready to package",
            "Only impact_ready runs can be packaged into prompt_ready runs.",
            code=3,
            error_code="validation_failed",
            valid_values=["impact_ready"],
        ), None
    artifacts = dict(run.get("artifacts") or {})
    output_path = Path(options.get("output") or artifacts.get("prompt_packet") or (Path(run["output_dir"]) / "delta-trace-prompt.md")).expanduser().resolve()
    would_write = str(output_path)
    if options.get("dry_run"):
        next_action = {
            "action": "package_run",
            "recommended_command": f"repo-review review package --run {run['run_id']} --json --no-input",
        }
        return 0, {
            "schema_version": SCHEMA_VERSION,
            "action": "package",
            "dry_run": True,
            "mutation_outcome": "dry_run",
            "run": {**run, "artifacts": {**artifacts, "prompt_packet": str(output_path)}},
            "would_write": [would_write, str(review_run_ledger_path(repo_root))],
            "warnings": [],
            "next_action": next_action,
        }
    if output_path.exists() and not options.get("overwrite") and run.get("status") != "prompt_ready":
        return fail(
            "prompt packet already exists",
            "Add --overwrite to replace the prompt packet or choose --output <path>.",
            code=5,
            error_code="unsafe_mutation_refused",
            valid_values=["--overwrite", "--output"],
        ), None
    review_state, code = load_json_file(run.get("prior_review_state"), "review-state")
    if code != 0:
        return code, None
    diff_report, code = load_json_file(artifacts.get("diff_report"), "diff-report")
    if code != 0:
        return code, None
    impact_plan, code = load_json_file(artifacts.get("impact_plan"), "impact-plan")
    if code != 0:
        return code, None
    assert review_state is not None and diff_report is not None and impact_plan is not None
    output_path.parent.mkdir(parents=True, exist_ok=True)
    output_path.write_text(build_delta_prompt(review_state, diff_report, impact_plan), encoding="utf-8")
    updated_artifacts = {**artifacts, "prompt_packet": str(output_path)}
    updated, update_errors = update_review_run_record(
        repo_root,
        run["run_id"],
        {"status": "prompt_ready", "artifacts": updated_artifacts},
    )
    if update_errors:
        return fail("run record is invalid", "; ".join(update_errors), code=3, error_code="validation_failed"), None
    assert updated is not None
    next_action = {
        "action": "send_prompt",
        "recommended_command": f"repo-review review ingest --run {run['run_id']} --input <review.md> --json --no-input",
    }
    return 0, {
        "schema_version": SCHEMA_VERSION,
        "action": "package",
        "dry_run": False,
        "mutation_outcome": "updated",
        "run": updated,
        "warnings": [],
        "next_action": next_action,
    }


def review_surface_drift_command(run: dict[str, Any], repo_root: Path) -> tuple[int, dict[str, Any] | None]:
    artifacts = dict(run.get("artifacts") or {})
    output_dir = Path(run.get("output_dir") or repo_root).expanduser().resolve()
    drift_path = output_dir / "delta-drift.json"
    code, drift_surface = drift_command(
        ["surface"],
        {
            "review_state": run.get("prior_review_state"),
            "diff_report": artifacts.get("diff_report"),
            "impact_plan": artifacts.get("impact_plan"),
            "to_review": run.get("run_id"),
        },
    )
    if code != 0:
        return code, None
    assert drift_surface is not None
    output_dir.mkdir(parents=True, exist_ok=True)
    atomic_write_json(drift_path, drift_surface)
    updated_artifacts = {**artifacts, "drift_surface": str(drift_path)}
    updated, update_errors = update_review_run_record(
        repo_root,
        run["run_id"],
        {"status": "drift_ready", "artifacts": updated_artifacts},
    )
    if update_errors:
        return fail("run record is invalid", "; ".join(update_errors), code=3, error_code="validation_failed"), None
    assert updated is not None
    return 0, {
        "schema_version": SCHEMA_VERSION,
        "action": "drift",
        "mutation_outcome": "updated",
        "run": updated,
        "artifacts": updated_artifacts,
        "drift_surface": str(drift_path),
        "warnings": [],
        "next_action": review_run_next_action("drift_ready"),
    }


def review_continue_command(options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    run, repo_root, errors = resolve_review_run(options)
    assert repo_root is not None
    if errors:
        return fail("review run was not found", errors[0], code=4, error_code="resource_not_found", valid_values=["--run", "--latest"]), None
    assert run is not None
    next_action = review_run_next_action(run.get("status"))
    if options.get("apply"):
        if run.get("status") == "impact_ready":
            package_options = {**options, "run": run["run_id"]}
            return review_package_command(package_options)
        if run.get("status") == "ingested":
            return review_surface_drift_command(run, repo_root)
        return 0, {
            "schema_version": SCHEMA_VERSION,
            "action": "continue",
            "applied": False,
            "run": run,
            "next_action": next_action,
            "blocker": "No deterministic transition is available for this status.",
        }
    return 0, {
        "schema_version": SCHEMA_VERSION,
        "action": "continue",
        "applied": False,
        "run": run,
        "next_action": next_action,
        "blocker": None if next_action.get("recommended_command") else next_action.get("next_action"),
    }


def parse_review_output(path: Path, kind: str) -> tuple[dict[str, Any], list[str]]:
    text = path.read_text(encoding="utf-8")
    if kind not in REVIEW_ARTIFACT_SCHEMAS:
        return {}, [f"Unknown review artifact kind {kind!r}."]
    stripped = text.lstrip()
    if stripped.startswith("{"):
        try:
            artifact = json.loads(text)
        except json.JSONDecodeError as exc:
            return {}, [f"Review artifact is not valid JSON: {exc.msg} at line {exc.lineno}, column {exc.colno}."]
        errors = validate_delta_review_artifact_shape(artifact)
        if errors:
            return {}, errors
        if artifact.get("kind") != kind:
            return {}, [f"Expected artifact kind {kind!r}; found {artifact.get('kind')!r}."]
        delta_review = artifact["delta_review"]
        candidate_claims = delta_review.get("candidate_claims", [])
        drift = delta_review.get("drift", [])
        return {
            "kind": kind,
            "path": str(path),
            "bytes": path.stat().st_size,
            "source_format": "json",
            "parser_mode": "structured-json",
            "summary": delta_review.get("summary", ""),
            "candidate_claim_count": len(candidate_claims),
            "candidate_claims": candidate_claims,
            "drift_count": len(drift),
            "drift": drift,
            "warnings": delta_review.get("warnings", []),
            "validation_errors": [],
        }, []

    block = extract_yaml_block(text, "delta_review") or extract_unfenced_yaml_block(text, "delta_review")
    source_format = "markdown-delta-review-block" if block else None
    if block is None:
        frontmatter = extract_frontmatter(text)
        if "delta_review" in frontmatter:
            block = text[4 : text.find("\n---", 4)]
            source_format = "markdown-frontmatter"
    if block is None:
        return {}, ["Expected a delta_review block in the reviewer output."]

    candidate_claims, candidate_claims_ok = yaml_list_items(block, "candidate_claims")
    drift, drift_ok = yaml_list_items(block, "drift")
    validation_errors: list[str] = []
    if not candidate_claims_ok:
        validation_errors.append("delta_review.candidate_claims must be an array.")
    if not drift_ok:
        validation_errors.append("delta_review.drift must be an array.")
    if validation_errors:
        return {}, validation_errors
    return {
        "kind": kind,
        "path": str(path),
        "bytes": path.stat().st_size,
        "source_format": source_format or "markdown-delta-review-block",
        "parser_mode": "structured-markdown",
        "summary": yaml_scalar_value(block, "summary") or "",
        "candidate_claim_count": len(candidate_claims),
        "candidate_claims": candidate_claims,
        "drift_count": len(drift),
        "drift": drift,
        "warnings": [],
        "validation_errors": [],
    }, []


def review_ingest_command(options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    run, repo_root, errors = resolve_review_run(options)
    assert repo_root is not None
    if errors:
        return fail("review run was not found", errors[0], code=4, error_code="resource_not_found", valid_values=["--run", "--latest"]), None
    assert run is not None
    input_value = options.get("input") or (run.get("artifacts") or {}).get("review_artifact")
    if not input_value:
        return fail("missing required --input", "Run: repo-review review ingest --run <id> --input <review-output> --json --no-input", valid_values=["--input"]), None
    input_path = Path(input_value).expanduser().resolve()
    if not input_path.is_file():
        return fail("review output was not found", f"Expected readable file at {input_path}.", code=4, error_code="resource_not_found", path=str(input_path)), None
    attach_only = bool(options.get("attach_only"))
    kind = options.get("kind") or "delta-review"
    target_status = "review_received" if attach_only else "ingested"
    artifacts = {**(run.get("artifacts") or {}), "review_artifact": str(input_path)}
    if options.get("dry_run"):
        return 0, {
            "schema_version": SCHEMA_VERSION,
            "action": "ingest",
            "dry_run": True,
            "mutation_outcome": "dry_run",
            "attach_only": attach_only,
            "run": {**run, "status": target_status, "artifacts": artifacts},
            "would_read": [str(input_path)],
            "would_write": [str(review_run_ledger_path(repo_root))],
            "candidate_claims": [],
            "drift": [],
            "warnings": [],
            "next_action": review_run_next_action(target_status),
        }
    parsed = {"kind": kind, "path": str(input_path), "bytes": input_path.stat().st_size, "candidate_claim_count": 0, "drift_count": 0}
    parse_warnings: list[str] = []
    if not attach_only:
        parsed, parse_warnings = parse_review_output(input_path, kind)
        if parse_warnings:
            return fail("review output has wrong artifact kind", parse_warnings[0], code=3, error_code="validation_failed", valid_values=["delta-review"], path=str(input_path)), None
    updated, update_errors = update_review_run_record(repo_root, run["run_id"], {"status": target_status, "artifacts": artifacts})
    if update_errors:
        return fail("run record is invalid", "; ".join(update_errors), code=3, error_code="validation_failed"), None
    assert updated is not None
    return 0, {
        "schema_version": SCHEMA_VERSION,
        "action": "ingest",
        "dry_run": False,
        "mutation_outcome": "updated",
        "attach_only": attach_only,
        "run": updated,
        "review_output": parsed,
        "candidate_claims": {"count": parsed.get("candidate_claim_count", 0)},
        "drift": {"count": parsed.get("drift_count", 0)},
        "warnings": parse_warnings,
        "next_action": review_run_next_action(target_status),
    }


def review_finish_command(options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    run, repo_root, errors = resolve_review_run(options)
    assert repo_root is not None
    if errors:
        return fail("review run was not found", errors[0], code=4, error_code="resource_not_found", valid_values=["--run", "--latest"]), None
    assert run is not None
    finishable = run.get("status") == "drift_ready"
    if options.get("dry_run"):
        return 0, {
            "schema_version": SCHEMA_VERSION,
            "action": "finish",
            "dry_run": True,
            "mutation_outcome": "dry_run",
            "finishable": finishable,
            "run": {**run, "status": "complete"} if finishable else run,
            "warnings": [] if finishable else ["Run is not finishable until drift has been surfaced and bound to the run."],
            "next_action": review_run_next_action("complete" if finishable else run.get("status")),
        }
    if not finishable:
        return fail(
            "run is not finishable",
            "Run review continue --run <id> --apply to surface drift before finishing the run.",
            code=5,
            error_code="unsafe_mutation_refused",
            valid_values=["review continue --apply"],
        ), None
    updated, update_errors = update_review_run_record(repo_root, run["run_id"], {"status": "complete"})
    if update_errors:
        return fail("run record is invalid", "; ".join(update_errors), code=3, error_code="validation_failed"), None
    assert updated is not None
    return 0, {
        "schema_version": SCHEMA_VERSION,
        "action": "finish",
        "dry_run": False,
        "mutation_outcome": "updated",
        "finishable": True,
        "run": updated,
        "warnings": [],
        "next_action": review_run_next_action("complete"),
    }


def review_status_command(options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    run, repo_root, errors = resolve_review_run(options)
    assert repo_root is not None
    if errors:
        return fail("review run was not found", errors[0], code=4, error_code="resource_not_found", valid_values=["--run", "--latest"]), None
    assert run is not None
    return 0, {
        "schema_version": SCHEMA_VERSION,
        "action": "status",
        "run": run,
        "warnings": run.get("warnings", []),
        "next_action": review_run_next_action(run.get("status")),
    }


def review_command(positionals: list[str], options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    if not positionals:
        return fail("missing review subcommand", "Use one of: start, package, continue, ingest, finish, status.", valid_values=["start", "package", "continue", "ingest", "finish", "status"]), None
    subcommand = positionals[0]
    if subcommand == "package":
        return review_package_command(options)
    if subcommand == "continue":
        return review_continue_command(options)
    if subcommand == "ingest":
        return review_ingest_command(options)
    if subcommand == "finish":
        return review_finish_command(options)
    if subcommand == "status":
        return review_status_command(options)
    if subcommand != "start":
        return fail(f"unknown review subcommand '{subcommand}'", "Use one of: start, package, continue, ingest, finish, status.", valid_values=["start", "package", "continue", "ingest", "finish", "status"]), None
    mode = options.get("mode")
    if mode != "delta":
        return fail("unsupported or missing --mode", "Only review start --mode delta is implemented in this CLI slice.", valid_values=["delta"]), None
    return review_start_delta_command(options)


def required_delta_inputs(options: dict[str, Any]) -> tuple[list[str], list[str]]:
    required = ["review-state", "diff-report", "impact-plan", "output"]
    missing = [name for name in required if not options.get(name.replace("-", "_"))]
    return required, missing


def next_command(options: dict[str, Any]) -> dict[str, Any]:
    required, missing = required_delta_inputs(options)
    output = options.get("output") or "reviews/<repo>/delta-<date>/delta-trace-prompt.md"
    if missing:
        next_action = "collect_delta_inputs"
        recommended = "repo-review diff --range <from>..<to> --json --no-input > diff-report.json"
    else:
        next_action = "export_delta_prompt"
        recommended = (
            "repo-review export-prompt --pass delta-trace "
            f"--review-state {options['review_state']} --diff-report {options['diff_report']} "
            f"--impact-plan {options['impact_plan']} --output {output} --json --no-input"
        )
    return {
        "schema_version": SCHEMA_VERSION,
        "next_action": next_action,
        "required_inputs": required,
        "missing_inputs": missing,
        "write_output_to": output,
        "recommended_command": recommended,
    }


def ingest_command(options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    input_path_value = options.get("input")
    kind = options.get("kind") or "external-analyzer-output"
    if not input_path_value:
        return fail("missing required --input", "Run: repo-review ingest --input <path> --json --no-input", valid_values=["--input"]), None
    input_path = Path(input_path_value)
    if not input_path.is_file():
        return fail("input artifact was not found", f"Expected readable file at {input_path}.", code=4, error_code="resource_not_found"), None
    parse_summary: dict[str, Any] | None = None
    parser_warnings: list[str] = []
    parser_validation_errors: list[str] = []
    if kind == "delta-review":
        parsed, parser_validation_errors = parse_review_output(input_path, kind)
        if parsed:
            parse_summary = {
                "kind": parsed["kind"],
                "source_format": parsed.get("source_format"),
                "parser_mode": parsed.get("parser_mode"),
                "candidate_claim_count": parsed.get("candidate_claim_count", 0),
                "drift_count": parsed.get("drift_count", 0),
                "warnings": parsed.get("warnings", []),
                "validation_errors": [],
            }
        else:
            parser_warnings = ["delta-review parser validation failed; recording low-level ingest entry with validation summary."]
            parse_summary = {
                "kind": kind,
                "source_format": None,
                "parser_mode": "structured",
                "candidate_claim_count": 0,
                "drift_count": 0,
                "warnings": parser_warnings,
                "validation_errors": parser_validation_errors,
            }
    elif kind != "external-analyzer-output":
        return fail(
            "unsupported artifact kind",
            "Low-level ingest currently supports external-analyzer-output and delta-review.",
            code=3,
            error_code="validation_failed",
            valid_values=["external-analyzer-output", "delta-review"],
        ), None
    STATE_DIR.mkdir(exist_ok=True)
    created_at = datetime.now(timezone.utc).replace(microsecond=0).isoformat()
    entry_id = "ingest-" + created_at.replace(":", "").replace("+", "Z")
    entry = {
        "schema_version": SCHEMA_VERSION,
        "entry_id": entry_id,
        "created_at": created_at,
        "kind": kind,
        "input": str(input_path),
        "bytes": input_path.stat().st_size,
    }
    if parse_summary is not None:
        entry["parse_summary"] = parse_summary
    with INGEST_PATH.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(entry, sort_keys=True) + "\n")
    return 0, {
        "schema_version": SCHEMA_VERSION,
        "mutation_outcome": "created",
        "entry_id": entry_id,
        "path": str(INGEST_PATH),
        "record": entry,
        "warnings": parser_warnings,
    }


def delta_command(options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    if options.get("wait"):
        return fail(
            "analysis execution is deferred in v1",
            "repo-review delta assembles prompt-packet workflow metadata; do not use --wait until jobs ship.",
            code=2,
            valid_values=["omit --wait"],
        ), None
    return 0, {
        "schema_version": SCHEMA_VERSION,
        "orchestration_model": "prompt-packet-only",
        "executes_analysis": False,
        "jobs_required": False,
        "jobs_deferred": True,
        **next_command(options),
    }


def qualify_claim_id(review_state_id: str, claim_id: str) -> str:
    return claim_id if ":" in claim_id else f"{review_state_id}:{claim_id}"


def claims_command(positionals: list[str], options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    if not positionals:
        return fail("missing claims subcommand", "Use one of: list, get, affected, import.", valid_values=["list", "get", "affected", "import"]), None
    subcommand, *rest = positionals

    if subcommand == "affected":
        impact_plan, code = load_json_file(options.get("impact_plan"), "impact-plan")
        if code != 0:
            return code, None
        assert impact_plan is not None
        from_review = impact_plan.get("from_review")
        affected = [
            {
                **claim,
                "qualified_claim_id": qualify_claim_id(from_review, claim.get("claim_id", "")),
            }
            for claim in impact_plan.get("impacted_claims", [])
        ]
        return 0, {"schema_version": SCHEMA_VERSION, "from_review": from_review, "affected_claims": affected}

    if subcommand == "import":
        return claims_import_command(options)

    review_state, code = load_json_file(options.get("review_state"), "review-state")
    if code != 0:
        return code, None
    assert review_state is not None
    review_state_id = review_state.get("id")
    claims = list(review_state.get("claims", []))

    if subcommand == "list":
        if options.get("claim_status"):
            claims = [claim for claim in claims if claim.get("claim_status") == options["claim_status"]]
        if options.get("kind"):
            claims = [claim for claim in claims if claim.get("kind") == options["kind"]]
        if options.get("subject"):
            claims = [claim for claim in claims if claim.get("subject", {}).get("ref") == options["subject"]]
        try:
            limit = int(options.get("limit") or 20)
        except ValueError:
            return fail("invalid --limit", "Use a positive integer for --limit.", valid_values=["1", "20", "50"]), None
        shown = claims[:limit]
        return 0, {
            "schema_version": SCHEMA_VERSION,
            "review_state": review_state_id,
            "claims": [
                {
                    "qualified_claim_id": qualify_claim_id(review_state_id, claim["id"]),
                    "id": claim["id"],
                    "kind": claim.get("kind"),
                    "claim_status": claim.get("claim_status"),
                    "subject": claim.get("subject"),
                    "statement": claim.get("statement"),
                }
                for claim in shown
            ],
            "truncation": {
                "limit": limit,
                "shown": len(shown),
                "total": len(claims),
                "truncated": len(claims) > len(shown),
            },
        }

    if subcommand == "get":
        if not rest:
            return fail("missing claim id", "Run: repo-review claims get <id> --review-state <path> --json --no-input"), None
        requested = rest[0].split(":", 1)[1] if ":" in rest[0] else rest[0]
        for claim in claims:
            if claim.get("id") == requested:
                return 0, {
                    "schema_version": SCHEMA_VERSION,
                    "review_state": review_state_id,
                    "qualified_claim_id": qualify_claim_id(review_state_id, claim["id"]),
                    "claim": claim,
                }
        return fail("claim was not found", f"No claim '{rest[0]}' exists in review state {review_state_id}.", code=4, error_code="resource_not_found"), None

    return fail(f"unknown claims subcommand '{subcommand}'", "Use one of: list, get, affected, import.", valid_values=["list", "get", "affected", "import"]), None


def claims_import_command(options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    review_state_path_value = options.get("review_state")
    input_path_value = options.get("input")
    review_state, code = load_json_file(review_state_path_value, "review-state")
    if code != 0:
        return code, None
    candidate_file, code = load_json_file(input_path_value, "input")
    if code != 0:
        return code, None
    assert review_state is not None
    assert candidate_file is not None
    review_state_id = review_state.get("id")

    state_errors = validate_review_state_shape(review_state)
    if state_errors:
        return fail(
            "review state is invalid",
            "; ".join(state_errors),
            code=3,
            error_code="validation_failed",
        ), None

    if candidate_file.get("review_state") != review_state_id and not options.get("force"):
        return fail(
            "candidate claims target a different review state",
            "Use a candidate file whose review_state matches the target, or pass --force after confirming the mismatch is intentional.",
            code=3,
            error_code="validation_failed",
            valid_values=["--force"],
        ), None

    source_identity_value = candidate_file.get("produced_by_analyzer")
    source_errors = validate_analyzer(source_identity_value, "produced_by_analyzer")
    if source_errors:
        return fail(
            "candidate file source identity is invalid",
            "; ".join(source_errors),
            code=3,
            error_code="validation_failed",
        ), None
    assert isinstance(source_identity_value, dict)

    candidates = candidate_file.get("candidate_claims")
    if not isinstance(candidates, list):
        return fail(
            "candidate_claims must be an array",
            "Provide candidate_claims as a list of human-authored claim objects.",
            code=3,
            error_code="validation_failed",
            valid_values=["candidate_claims"],
        ), None

    candidate_errors: list[str] = []
    inherited_claims: list[dict[str, Any]] = []
    seen_candidate_ids: set[str] = set()
    duplicate_candidate_ids: list[str] = []
    for index, candidate in enumerate(candidates):
        label = f"candidate_claims[{index}]"
        candidate_errors.extend(validate_claim_shape(candidate, label, require_identity=False))
        if not isinstance(candidate, dict):
            continue
        claim_id = candidate.get("id")
        if claim_id in seen_candidate_ids:
            duplicate_candidate_ids.append(claim_id)
        seen_candidate_ids.add(claim_id)
        inherited = dict(candidate)
        inherited.setdefault("produced_by_analyzer", source_identity_value)
        candidate_errors.extend(validate_claim_shape(inherited, f"inherited_claims[{index}]", require_identity=True))
        inherited_claims.append(inherited)
    if duplicate_candidate_ids:
        candidate_errors.append("candidate file contains duplicate claim IDs: " + ", ".join(sorted(set(duplicate_candidate_ids))))
    if candidate_errors:
        return fail(
            "candidate claims are invalid",
            "; ".join(candidate_errors),
            code=3,
            error_code="validation_failed",
        ), None

    existing_claims = list(review_state.get("claims", []))
    existing_by_id = {claim.get("id"): claim for claim in existing_claims}
    duplicates = [claim["id"] for claim in inherited_claims if claim["id"] in existing_by_id]
    if duplicates and not options.get("overwrite_claims"):
        return fail(
            "duplicate claim IDs refused",
            "Use --overwrite-claims to replace matching claims, or edit the candidate IDs.",
            code=5,
            error_code="unsafe_mutation_refused",
            valid_values=["--overwrite-claims"],
        ), None

    replacing = set(duplicates) if options.get("overwrite_claims") else set()
    preserved = [claim for claim in existing_claims if claim.get("id") not in replacing]
    updated_claims = [*preserved, *inherited_claims]
    updated_state = {**review_state, "claims": updated_claims}
    final_errors = validate_review_state_shape(updated_state)
    if final_errors:
        return fail(
            "imported review state would be invalid",
            "; ".join(final_errors),
            code=3,
            error_code="validation_failed",
        ), None

    review_state_path = Path(str(review_state_path_value)).expanduser().resolve()
    audit_log_path = review_state_path.with_name("review-state.imports.jsonl")
    atomic_write_json(review_state_path, updated_state)
    audit = {
        "timestamp": iso_now(),
        "review_state_id": review_state_id,
        "review_state": str(review_state_path),
        "candidate_claims_input": str(Path(str(input_path_value)).expanduser().resolve()),
        "imported": len(inherited_claims),
        "skipped": 0,
        "duplicates": len(duplicates),
        "replaced": len(replacing),
        "warnings": candidate_file.get("warnings", []),
        "tool_identity": {
            "id": "repo-review-cli",
            "kind": "tool",
            "model": None,
            "tool_context": "repo-review claims import",
        },
        "candidate_source_identity": source_identity_value,
    }
    with audit_log_path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(audit, sort_keys=True) + "\n")

    return 0, {
        "schema_version": SCHEMA_VERSION,
        "review_state": str(review_state_path),
        "review_state_id": review_state_id,
        "imported": len(inherited_claims),
        "skipped": 0,
        "replaced": len(replacing),
        "duplicates": duplicates,
        "audit_log": str(audit_log_path),
        "warnings": candidate_file.get("warnings", []),
        "next_commands": [
            f"repo-review claims list --review-state {review_state_path} --json --no-input",
            f"repo-review impact --review-state {review_state_path} --diff-report <path> --json --no-input",
        ],
    }


def analyzer_key(analyzer: dict[str, Any]) -> str:
    return "|".join(
        str(analyzer.get(field) or "")
        for field in ("id", "kind", "model", "tool_context")
    )


def collect_analyzers(review_state: dict[str, Any]) -> list[dict[str, Any]]:
    analyzers: dict[str, dict[str, Any]] = {}
    candidates = [review_state.get("produced_by_analyzer")]
    candidates.extend(output.get("produced_by_analyzer") for output in review_state.get("pass_outputs", []))
    candidates.extend(claim.get("produced_by_analyzer") for claim in review_state.get("claims", []))
    for analyzer in candidates:
        if isinstance(analyzer, dict):
            analyzers[analyzer_key(analyzer)] = {
                "id": analyzer.get("id"),
                "kind": analyzer.get("kind"),
                "model": analyzer.get("model"),
                "tool_context": analyzer.get("tool_context"),
            }
    return sorted(analyzers.values(), key=lambda item: (str(item.get("id")), str(item.get("tool_context"))))


def aggregate_command(options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    review_state_paths = option_values(options, "review_state")
    if not review_state_paths:
        return fail(
            "missing required --review-state",
            "Run: repo-review aggregate --review-state <path> --review-state <path> --json --no-input",
            valid_values=["--review-state"],
        ), None
    try:
        limit = int(options.get("limit") or 10)
    except (TypeError, ValueError):
        return fail("invalid --limit", "Use a positive integer for --limit.", valid_values=["1", "10", "50"]), None

    review_summaries: list[dict[str, Any]] = []
    total_claim_status_counts: dict[str, int] = {}
    total_kind_counts: dict[str, int] = {}
    analyzers_by_key: dict[str, dict[str, Any]] = {}

    for index, path_value in enumerate(review_state_paths, start=1):
        review_state, code = load_json_file(path_value, f"review-state {index}")
        if code != 0:
            return code, None
        assert review_state is not None
        review_state_id = review_state.get("id")
        claims = list(review_state.get("claims", []))
        claim_status_counts: dict[str, int] = {}
        kind_counts: dict[str, int] = {}
        for claim in claims:
            add_count(claim_status_counts, claim.get("claim_status"))
            add_count(total_claim_status_counts, claim.get("claim_status"))
            add_count(kind_counts, claim.get("kind"))
            add_count(total_kind_counts, claim.get("kind"))

        analyzers = collect_analyzers(review_state)
        for analyzer in analyzers:
            key = analyzer_key(analyzer)
            existing = analyzers_by_key.setdefault(
                key,
                {
                    **analyzer,
                    "review_states": [],
                },
            )
            existing["review_states"].append(review_state_id)

        drift_surface = review_state.get("drift_surface") or {}
        review_summaries.append(
            {
                "path": path_value,
                "id": review_state_id,
                "repo": review_state.get("repo", {}).get("name"),
                "mode": review_state.get("mode"),
                "claim_count": len(claims),
                "claim_status_counts": dict(sorted(claim_status_counts.items())),
                "claim_kind_counts": dict(sorted(kind_counts.items())),
                "analyzers": analyzers,
                "drift_surface_counts": {
                    "snapshot_entries": len(drift_surface.get("snapshot_entries", [])),
                    "fascination_seeds": len(drift_surface.get("fascination_seeds", [])),
                },
                "sample_qualified_claim_ids": [
                    qualify_claim_id(review_state_id, claim.get("id", ""))
                    for claim in claims[: max(limit, 0)]
                ],
            }
        )

    drift_counts = {
        "new_snapshot_entries": 0,
        "invalidated_snapshot_entries": 0,
        "strengthened_fascination_seeds": 0,
        "weakened_fascination_seeds": 0,
        "new_fascination_seeds": 0,
        "lane_impacts": 0,
    }
    drift_outputs: list[dict[str, Any]] = []
    for index, path_value in enumerate(option_values(options, "drift"), start=1):
        drift, code = load_json_file(path_value, f"drift {index}")
        if code != 0:
            return code, None
        assert drift is not None
        for key in drift_counts:
            drift_counts[key] += len(drift.get(key, []))
        drift_outputs.append(
            {
                "path": path_value,
                "repo": drift.get("repo"),
                "from_review": drift.get("from_review"),
                "to_review": drift.get("to_review"),
                "diff_range": drift.get("diff_range"),
            }
        )

    analyzers = sorted(analyzers_by_key.values(), key=lambda item: (str(item.get("id")), str(item.get("tool_context"))))
    return 0, {
        "schema_version": SCHEMA_VERSION,
        "review_state_count": len(review_summaries),
        "review_states": review_summaries,
        "totals": {
            "claim_count": sum(item["claim_count"] for item in review_summaries),
            "claim_status_counts": dict(sorted(total_claim_status_counts.items())),
            "claim_kind_counts": dict(sorted(total_kind_counts.items())),
            "analyzer_count": len(analyzers),
            "drift_output_count": len(drift_outputs),
        },
        "analyzers": analyzers,
        "drift_material": {
            "outputs": drift_outputs,
            "counts": drift_counts,
        },
        "claim_identity": {
            "global_claim_identity_supported": False,
            "qualified_id_required": True,
            "scope": "Claim IDs are local to each review_state; aggregation never merges same-named claims across reviews.",
        },
    }


def drift_command(positionals: list[str], options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    if not positionals or positionals[0] != "surface":
        return fail(
            "missing or unsupported drift subcommand",
            "Run: repo-review drift surface --review-state <path> --diff-report <path> --impact-plan <path> --json --no-input",
            valid_values=["surface"],
        ), None
    review_state, code = load_json_file(options.get("review_state"), "review-state")
    if code != 0:
        return code, None
    diff_report, code = load_json_file(options.get("diff_report"), "diff-report")
    if code != 0:
        return code, None
    impact_plan, code = load_json_file(options.get("impact_plan"), "impact-plan")
    if code != 0:
        return code, None
    assert review_state is not None
    assert diff_report is not None
    assert impact_plan is not None

    from_review = review_state.get("id")
    to_review = options.get("to_review") or f"{from_review}-delta"
    impacted = impact_plan.get("impacted_claims", [])
    unknowns = impact_plan.get("unknowns", [])
    return 0, {
        "schema_version": SCHEMA_VERSION,
        "repo": review_state.get("repo", {}).get("name"),
        "from_review": from_review,
        "to_review": to_review,
        "diff_range": diff_report.get("range", {}).get("expression"),
        "produced_by_analyzer": {
            "id": "repo-review-cli",
            "kind": "tool",
            "model": None,
            "tool_context": "repo-review drift surface",
        },
        "new_snapshot_entries": [
            {
                "reason": "Diff contains unknown changed files that may require new review observations.",
                "source_claim": item.get("claim_id"),
                "changed_file": item.get("changed_file"),
            }
            for item in unknowns
        ],
        "invalidated_snapshot_entries": [
            {
                "source_claim": item.get("claim_id"),
                "reason": item.get("reason", "Impacted claim may be invalidated by the diff."),
            }
            for item in impacted
            if item.get("impact") == "possibly_invalidated"
        ],
        "strengthened_fascination_seeds": [
            {
                "source_claim": item.get("claim_id"),
                "reason": item.get("reason", "Impacted claim may be strengthened by the diff."),
            }
            for item in impacted
            if item.get("impact") == "possibly_strengthened"
        ],
        "weakened_fascination_seeds": [
            {
                "source_claim": item.get("claim_id"),
                "reason": item.get("reason", "Impacted claim needs delta review; treating as possibly weakened until analyzed."),
            }
            for item in impacted
            if item.get("impact") in {"possibly_weakened", "unknown"}
        ],
        "new_fascination_seeds": [
            {
                "reason": "Unknown changed material may produce a new fascination seed after analyst review.",
                "changed_file": item.get("changed_file"),
            }
            for item in unknowns
        ],
        "lane_impacts": [
            {
                "lane": "repo-review",
                "impact": "unknown" if impacted or unknowns else "unchanged",
                "reason": "Delta impact is derived from the impact plan and awaits analyzer review.",
            }
        ],
    }


def resolve_config(options: dict[str, Any]) -> dict[str, Any]:
    profiles = load_profiles()
    selected_profile = options.get("profile")
    profile = profiles.get(selected_profile, {}) if selected_profile else {}

    fields = {
        "repo_root": {
            "flag": "repo",
            "env": "REPO_REVIEW_REPO",
            "profile": "repo_root",
            "default": str(ROOT),
        },
        "review_output_dir": {
            "flag": "output",
            "env": "REPO_REVIEW_OUTPUT",
            "profile": "review_output_dir",
            "default": str(ROOT / "reviews"),
        },
        "analyzer_id": {
            "flag": "analyzer_id",
            "env": "REPO_REVIEW_ANALYZER_ID",
            "profile": "analyzer_id",
            "default": "unknown",
        },
        "lane_vocabulary_path": {
            "flag": "lane_vocabulary",
            "env": "REPO_REVIEW_LANE_VOCABULARY",
            "profile": "lane_vocabulary_path",
            "default": None,
        },
        "output_mode": {
            "flag": "output_mode",
            "env": "REPO_REVIEW_OUTPUT_MODE",
            "profile": "output_mode",
            "default": "json",
        },
    }

    configured: dict[str, Any] = {}
    sources: dict[str, str] = {}
    for field, spec in fields.items():
        flag_name = spec["flag"]
        if options.get(flag_name) not in (None, ""):
            configured[field] = options[flag_name]
            sources[field] = "flag"
        elif os.environ.get(spec["env"]):
            configured[field] = os.environ[spec["env"]]
            sources[field] = "environment"
        elif profile.get(spec["profile"]) not in (None, ""):
            configured[field] = profile[spec["profile"]]
            sources[field] = "profile"
        else:
            configured[field] = spec["default"]
            sources[field] = "default"

    return {
        "profile": selected_profile,
        "configured_paths": configured,
        "sources": sources,
    }


def status(options: dict[str, Any]) -> dict[str, Any]:
    config = resolve_config(options)
    repo_root = Path(config["configured_paths"]["repo_root"]).expanduser().resolve()
    review_states, state_warnings = discover_review_states(repo_root)
    latest_state = review_states[0] if review_states else None
    latest_state_id = latest_state.get("id") if latest_state else None
    runs, run_errors = read_review_run_ledger(repo_root)
    latest_runs = sorted(latest_review_runs(runs).values(), key=lambda item: item.get("updated_at", ""), reverse=True)
    open_runs = [summarize_run(run) for run in latest_runs if run.get("status") not in {"complete", "failed"}]
    prompt_ready_runs = [run for run in open_runs if run.get("status") == "prompt_ready"]
    complete_runs = [summarize_run(run) for run in latest_runs if run.get("status") == "complete"]
    candidate_claims = discover_candidate_claim_files(repo_root, str(latest_state_id) if latest_state_id else None)
    if prompt_ready_runs:
        summary = "prompt_ready"
        next_action = {
            "action": "ingest_review",
            "reason": "At least one run has a prompt ready for reviewer output.",
            "recommended_command": f"repo-review review ingest --run {prompt_ready_runs[0]['run_id']} --input <review.md> --json --no-input",
        }
    elif open_runs:
        summary = "run_open"
        next_action = {
            "action": "inspect_run",
            "reason": "A review run is in progress.",
            "recommended_command": f"repo-review runs get {open_runs[0]['run_id']} --json --no-input",
        }
    elif candidate_claims and latest_state:
        summary = "candidate_claims_waiting"
        next_action = {
            "action": "import_candidate_claims",
            "reason": "Candidate claims were found for the latest review state.",
            "recommended_command": f"repo-review claims import --review-state {latest_state['path']} --input {candidate_claims[0]['path']} --json --no-input",
        }
    elif latest_state:
        summary = "state_ready"
        next_action = {
            "action": "start_delta_review",
            "reason": "A review state is available and no open runs were found.",
            "recommended_command": f"repo-review review start --mode delta --repo {repo_root} --review-state {latest_state['path']} --range <from>..<to> --json --no-input",
        }
    else:
        summary = "no_review_state"
        next_action = {
            "action": "bootstrap_review_state",
            "reason": "No review state was discovered for this repo.",
            "recommended_command": "repo-review state bootstrap --repo <path> --review-dir <path> --output <review-state.json> --json --no-input",
        }
    workflow_state = {
        "summary": summary,
        "latest_review_state": latest_state,
        "open_runs": open_runs,
        "prompt_ready_runs": prompt_ready_runs,
        "complete_runs": complete_runs,
        "candidate_claims_waiting": candidate_claims,
        "warnings": [*state_warnings, *run_errors],
        "next_action": next_action,
    }
    return {
        "schema_version": SCHEMA_VERSION,
        **config,
        "available_profiles": profile_names(),
        "workflow_state": workflow_state,
        "next_actions": [next_action],
    }


def template_by_id(template_id: str) -> dict[str, Any] | None:
    for template in HELPER_TEMPLATES:
        if template["id"] == template_id:
            return template
    return None


def template_payload(template: dict[str, Any]) -> dict[str, Any]:
    path = ROOT / template["path"]
    return {
        **template,
        "absolute_path": str(path),
        "exists": path.is_file(),
    }


def templates_command(positionals: list[str], options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    if not positionals:
        return fail("missing templates subcommand", "Use one of: list, get, write.", valid_values=["list", "get", "write"]), None
    subcommand, *rest = positionals
    if subcommand == "list":
        return 0, {
            "schema_version": SCHEMA_VERSION,
            "templates": [template_payload(template) for template in HELPER_TEMPLATES],
            "suggestions": {
                "candidate_claims": "bootstrap-candidate-claims",
                "affected_claims": "affected-claims",
                "drift": "drift-summary",
                "contested": "contested-claim",
            },
        }
    if subcommand in {"get", "write"}:
        if not rest:
            return fail("missing template id", f"Run: repo-review templates {subcommand} <id> --json --no-input", valid_values=[template["id"] for template in HELPER_TEMPLATES]), None
        template = template_by_id(rest[0])
        if template is None:
            return fail(
                "template was not found",
                f"No helper template '{rest[0]}' is registered.",
                code=4,
                error_code="resource_not_found",
                valid_values=[template["id"] for template in HELPER_TEMPLATES],
            ), None
        source_path = ROOT / template["path"]
        text = source_path.read_text(encoding="utf-8")
        payload = {"schema_version": SCHEMA_VERSION, "template": template_payload(template), "content": text}
        if subcommand == "get":
            return 0, payload
        output = options.get("output")
        if not output:
            return fail("missing required --output", "Run: repo-review templates write <id> --output <path> --json --no-input", valid_values=["--output"]), None
        output_path = Path(output).expanduser().resolve()
        if output_path.exists() and not options.get("overwrite"):
            return fail(
                "output path already exists",
                "Add --overwrite to replace the existing template copy.",
                code=5,
                error_code="unsafe_mutation_refused",
                valid_values=["--overwrite"],
            ), None
        output_path.parent.mkdir(parents=True, exist_ok=True)
        output_path.write_text(text, encoding="utf-8")
        return 0, {**payload, "output": str(output_path), "mutation_outcome": "created"}
    return fail(f"unknown templates subcommand '{subcommand}'", "Use one of: list, get, write.", valid_values=["list", "get", "write"]), None


def profile_command(positionals: list[str], options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    if not positionals:
        values = ["list", "show", "save", "delete"]
        return fail("missing profile subcommand", "Use one of: list, show, save, delete.", valid_values=values), None
    subcommand, *rest = positionals
    profiles = load_profiles()

    if subcommand == "list":
        return 0, {"schema_version": SCHEMA_VERSION, "profiles": sorted(profiles)}

    if subcommand == "show":
        if not rest:
            return fail("missing profile name", "Run: repo-review profile show <name> --json"), None
        name = rest[0]
        if name not in profiles:
            values = sorted(profiles)
            return fail(
                f"profile '{name}' was not found",
                f"Use one of: {', '.join(values) or '(none)'}.",
                code=4,
                error_code="resource_not_found",
                valid_values=values,
            ), None
        return 0, {"schema_version": SCHEMA_VERSION, "name": name, "profile": profiles[name]}

    if subcommand == "save":
        if not rest:
            return fail("missing profile name", "Run: repo-review profile save <name> --repo <path> --output <path> --json --no-input"), None
        name = rest[0]
        profile = {
            "repo_root": options.get("repo") or str(ROOT),
            "review_output_dir": options.get("output") or str(ROOT / "reviews"),
            "analyzer_id": options.get("analyzer_id") or "unknown",
            "lane_vocabulary_path": options.get("lane_vocabulary"),
            "output_mode": options.get("output_mode") or "json",
        }
        profiles[name] = profile
        save_profiles(profiles)
        return 0, {"schema_version": SCHEMA_VERSION, "name": name, "profile": profile, "path": str(PROFILES_PATH)}

    if subcommand == "delete":
        if not rest:
            return fail("missing profile name", "Run: repo-review profile delete <name> --force --json --no-input"), None
        if not options.get("force"):
            return fail(
                "unsafe mutation refused",
                "Add --force to delete a profile.",
                code=5,
                error_code="unsafe_mutation_refused",
                valid_values=["--force"],
            ), None
        name = rest[0]
        existed = name in profiles
        profiles.pop(name, None)
        save_profiles(profiles)
        return 0, {"schema_version": SCHEMA_VERSION, "name": name, "deleted": existed, "path": str(PROFILES_PATH)}

    values = ["list", "show", "save", "delete"]
    return fail(f"unknown profile subcommand '{subcommand}'", "Use one of: list, show, save, delete.", valid_values=values), None


def load_feedback_entries() -> list[dict[str, Any]]:
    if not FEEDBACK_PATH.exists():
        return []
    entries: list[dict[str, Any]] = []
    with FEEDBACK_PATH.open(encoding="utf-8") as handle:
        for line in handle:
            if line.strip():
                entries.append(json.loads(line))
    return entries


def feedback(positionals: list[str], options: dict[str, Any]) -> dict[str, Any] | tuple[int, None]:
    if not positionals:
        return fail(
            "missing feedback message or subcommand",
            "Run: repo-review feedback \"message\" --json --no-input, or use list/get/export.",
            valid_values=["list", "get", "export"],
            feedback_hint="Use feedback list to inspect local feedback before exporting it.",
        ), None
    subcommand = positionals[0]
    if subcommand == "list":
        try:
            limit = int(options.get("limit") or 20)
        except (TypeError, ValueError):
            return fail("invalid --limit", "Use a positive integer for --limit.", valid_values=["1", "20", "50"]), None
        entries = load_feedback_entries()
        shown = entries[-limit:]
        return {
            "schema_version": SCHEMA_VERSION,
            "feedback": shown,
            "truncation": {"limit": limit, "shown": len(shown), "total": len(entries), "truncated": len(entries) > len(shown)},
            "path": str(FEEDBACK_PATH),
        }
    if subcommand == "get":
        if len(positionals) < 2:
            return fail("missing feedback id", "Run: repo-review feedback get <entry-id> --json --no-input", feedback_hint="Use feedback list to find entry IDs."), None
        entry_id = positionals[1]
        for entry in load_feedback_entries():
            if entry.get("entry_id") == entry_id:
                return {"schema_version": SCHEMA_VERSION, "entry": entry, "path": str(FEEDBACK_PATH)}
        return fail(
            "feedback entry was not found",
            f"No feedback entry '{entry_id}' exists in {FEEDBACK_PATH}.",
            code=4,
            error_code="resource_not_found",
            feedback_hint="Use feedback list to find entry IDs.",
        ), None
    if subcommand == "export":
        output = options.get("output")
        if not output:
            return fail("missing required --output", "Run: repo-review feedback export --output <path> --json --no-input", valid_values=["--output"]), None
        output_path = Path(output).expanduser().resolve()
        if output_path.exists() and not options.get("overwrite"):
            return fail(
                "output path already exists",
                "Add --overwrite to replace the exported feedback file.",
                code=5,
                error_code="unsafe_mutation_refused",
                valid_values=["--overwrite"],
            ), None
        entries = load_feedback_entries()
        output_path.parent.mkdir(parents=True, exist_ok=True)
        output_path.write_text(json.dumps({"schema_version": SCHEMA_VERSION, "feedback": entries}, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        return {"schema_version": SCHEMA_VERSION, "path": str(output_path), "feedback_count": len(entries), "mutation_outcome": "created" if len(entries) else "unchanged"}
    if subcommand == "send":
        return fail(
            "feedback send is deferred in v1",
            "Use feedback export --output <path> and send the file through the project-approved channel.",
            code=2,
            valid_values=["list", "get", "export"],
            feedback_hint="Local feedback remains in .repo-review/feedback.jsonl.",
        ), None
    STATE_DIR.mkdir(exist_ok=True)
    created_at = datetime.now(timezone.utc).isoformat()
    entry_id = "feedback-" + created_at.replace(":", "").replace(".", "").replace("+", "Z")
    entry = {
        "schema_version": SCHEMA_VERSION,
        "entry_id": entry_id,
        "created_at": created_at,
        "message": " ".join(positionals),
    }
    with FEEDBACK_PATH.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(entry, sort_keys=True) + "\n")
    return {"schema_version": SCHEMA_VERSION, "entry_id": entry_id, "path": str(FEEDBACK_PATH)}


def main(argv: list[str]) -> int:
    global DIAGNOSTIC_JSON_MODE
    DIAGNOSTIC_JSON_MODE = "--json" in argv

    if not argv or argv[0] in {"-h", "--help"}:
        commands = ", ".join(sorted(COMMANDS))
        return fail(
            "missing command",
            f"Use one of: {commands}. Example: repo-review agent-context --json",
            valid_values=sorted(COMMANDS),
        )

    command, *args = argv
    if command not in COMMANDS:
        commands = ", ".join(sorted(COMMANDS))
        return fail(f"unknown command '{command}'", f"Use one of: {commands}.", valid_values=sorted(COMMANDS))

    positionals, options = parse_args(args)
    json_mode = bool(options.get("json"))

    if not json_mode and not human_output_supported(command, positionals):
        return fail(
            f"{command} requires --json in the current CLI slice",
            f"Run: repo-review {command} --json",
        )

    if command == "agent-context":
        return emit_json(agent_context())
    if command == "diff":
        code, payload = diff_command(options)
        if code != 0:
            return code
        return emit_result(command, positionals, payload or {}, json_mode)
    if command == "delta":
        code, payload = delta_command(options)
        if code != 0:
            return code
        return emit_json(payload or {})
    if command == "aggregate":
        code, payload = aggregate_command(options)
        if code != 0:
            return code
        return emit_result(command, positionals, payload or {}, json_mode)
    if command == "claims":
        code, payload = claims_command(positionals, options)
        if code != 0:
            return code
        return emit_result(command, positionals, payload or {}, json_mode)
    if command == "drift":
        code, payload = drift_command(positionals, options)
        if code != 0:
            return code
        return emit_json(payload or {})
    if command == "feedback":
        result = feedback(positionals, options)
        if isinstance(result, tuple):
            code, _ = result
            return code
        return emit_json(result)
    if command == "export-prompt":
        code, payload = export_prompt_command(options)
        if code != 0:
            return code
        return emit_result(command, positionals, payload or {}, json_mode)
    if command == "impact":
        code, payload = impact_command(options)
        if code != 0:
            return code
        return emit_result(command, positionals, payload or {}, json_mode)
    if command == "ingest":
        code, payload = ingest_command(options)
        if code != 0:
            return code
        return emit_json(payload or {})
    if command == "next":
        return emit_json(next_command(options))
    if command == "profile":
        code, payload = profile_command(positionals, options)
        if code != 0:
            return code
        return emit_json(payload or {})
    if command == "review":
        code, payload = review_command(positionals, options)
        if code != 0:
            return code
        return emit_result(command, positionals, payload or {}, json_mode)
    if command == "runs":
        code, payload = runs_command(positionals, options)
        if code != 0:
            return code
        return emit_result(command, positionals, payload or {}, json_mode)
    if command == "state":
        code, payload = state_command(positionals, options)
        if code != 0:
            return code
        return emit_result(command, positionals, payload or {}, json_mode)
    if command == "skill-path":
        if not MANIFEST_DIR.is_dir() or not MANIFEST_PATH.is_file():
            return fail(
                "skill manifest is missing",
                f"Expected readable manifest at {MANIFEST_PATH}.",
                code=4,
                error_code="resource_not_found",
            )
        return emit_json(skill_path())
    if command == "status":
        return emit_result(command, positionals, status(options), json_mode)
    if command == "templates":
        code, payload = templates_command(positionals, options)
        if code != 0:
            return code
        return emit_json(payload or {})

    return fail(f"command '{command}' is registered but not implemented", "Check agent-context for shipped commands.", code=1)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
