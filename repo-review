def flag_specs(names: list[str]) -> dict[str, dict[str, Any]]:
    return {name: dict(FLAG_SCHEMA.get(name, {"type": "string", "required": False})) for name in names}


def command_schema(
    purpose: str,
    flags: list[str],
    *,
    subcommands: list[str] | None = None,
    output_schema: str | None = None,
    workflow_role: str = "primitive",
    mutation: bool = False,
    dry_run: bool = False,
    implemented: bool = True,
    examples: list[str] | None = None,
    idempotency: dict[str, Any] | None = None,
    allowed_mutation_outcomes: list[str] | None = None,
    deferred: dict[str, Any] | None = None,
    artifact_schemas: list[str] | None = None,
    flag_overrides: dict[str, dict[str, Any]] | None = None,
) -> dict[str, Any]:
    flags_payload = flag_specs(flags)
    if flag_overrides:
        for name, override in flag_overrides.items():
            flags_payload[name] = {**flags_payload.get(name, {}), **override}
    return {
        "purpose": purpose,
        "workflow_role": workflow_role,
        "implemented": implemented,
        "mutation": mutation,
        "dry_run": dry_run,
        "flags": flags_payload,
        "subcommands": subcommands or [],
        "output_schema": output_schema,
        "examples": examples or [],
        "idempotency": idempotency,
        "allowed_mutation_outcomes": allowed_mutation_outcomes or [],
        "deferred": deferred or {},
        "artifact_schemas": artifact_schemas or [],
    }


