def emit_json(payload: dict[str, Any]) -> int:
    print(json.dumps(payload, indent=2, sort_keys=True))
    return 0


def fail(
    message: str,
    hint: str,
    code: int = 2,
    error_code: str = "invalid_invocation",
    valid_values: list[str] | None = None,
) -> int:
    diagnostic: dict[str, Any] = {
        "code": error_code,
        "message": message,
        "hint": hint,
    }
    if valid_values is not None:
        diagnostic["valid_values"] = valid_values
    print(json.dumps(diagnostic, sort_keys=True), file=sys.stderr)
    return code


def require_json(args: list[str]) -> bool:
    return "--json" in args


def load_profiles() -> dict[str, dict[str, Any]]:
    if not PROFILES_PATH.exists():
        return {}
    with PROFILES_PATH.open(encoding="utf-8") as handle:
        data = json.load(handle)
    profiles = data.get("profiles", {})
    return profiles if isinstance(profiles, dict) else {}


def save_profiles(profiles: dict[str, dict[str, Any]]) -> None:
    STATE_DIR.mkdir(exist_ok=True)
    with PROFILES_PATH.open("w", encoding="utf-8") as handle:
        json.dump({"schema_version": SCHEMA_VERSION, "profiles": profiles}, handle, indent=2, sort_keys=True)
        handle.write("\n")


def parse_args(args: list[str]) -> tuple[list[str], dict[str, Any]]:
    positionals: list[str] = []
    options: dict[str, Any] = {}
    boolean_flags = {"--json", "--no-input", "--force", "--overwrite", "--dry-run"}
    index = 0
    while index < len(args):
        arg = args[index]
        if arg in boolean_flags:
            options[arg[2:].replace("-", "_")] = True
            index += 1
            continue
        if arg.startswith("--"):
            if index + 1 >= len(args) or args[index + 1].startswith("--"):
                options[arg[2:].replace("-", "_")] = None
                index += 1
                continue
            options[arg[2:].replace("-", "_")] = args[index + 1]
            index += 2
            continue
        positionals.append(arg)
        index += 1
    return positionals, options


