DIAGNOSTIC_JSON_MODE = True


def fail(
    message: str,
    hint: str,
    code: int = 2,
    error_code: str = "invalid_invocation",
    valid_values: list[str] | None = None,
    path: str | None = None,
    expected_artifact_kind: str | None = None,
    examples: list[str] | None = None,
    feedback_hint: str | None = None,
) -> int:
    diagnostic: dict[str, Any] = {
        "code": error_code,
        "message": message,
        "hint": hint,
    }
    if valid_values is not None:
        diagnostic["valid_values"] = valid_values
    if path is not None:
        diagnostic["path"] = path
    if expected_artifact_kind is not None:
        diagnostic["expected_artifact_kind"] = expected_artifact_kind
    if examples:
        diagnostic["examples"] = examples
    if feedback_hint is not None:
        diagnostic["feedback_hint"] = feedback_hint
    if DIAGNOSTIC_JSON_MODE:
        print(json.dumps(diagnostic, sort_keys=True), file=sys.stderr)
    else:
        lines = [f"Error: {message}", f"Hint: {hint}"]
        if valid_values is not None:
            lines.append(f"Valid values: {', '.join(valid_values) or '(none)'}")
        if expected_artifact_kind is not None:
            lines.append(f"Expected artifact: {expected_artifact_kind}")
        if path is not None:
            lines.append(f"Path: {path}")
        if examples:
            lines.extend(["Examples:", *(f"  {example}" for example in examples)])
        if feedback_hint is not None:
            lines.append(f"Feedback: {feedback_hint}")
        print("\n".join(lines), file=sys.stderr)
    return code


