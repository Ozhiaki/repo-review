def render_command_registry_docs() -> str:
    lines = [
        COMMAND_REGISTRY_START,
        "| Command | Role | Mutation | Dry run | Output schema | Flags | Outcomes | Examples |",
        "| --- | --- | --- | --- | --- | --- | --- | --- |",
    ]
    for name, entry in sorted(COMMAND_SCHEMA.items()):
