def emit_json(payload: dict[str, Any]) -> int:
    print(json.dumps(payload, indent=2, sort_keys=True))
    return 0


def human_output_supported(command: str, positionals: list[str]) -> bool:
    if command in {"status", "diff", "impact", "export-prompt", "aggregate"}:
        return True
    if command == "runs" and positionals[:1] in (["list"], ["get"], ["prune"]):
        return True
    if command == "review" and positionals[:1] in (["start"], ["package"], ["continue"], ["ingest"], ["finish"], ["status"]):
        return True
    if command == "state" and positionals[:1] in (["bootstrap"], ["list"], ["latest"], ["get"], ["validate"]):
        return True
    if command == "claims" and positionals[:1] == ["list"]:
        return True
    return False


