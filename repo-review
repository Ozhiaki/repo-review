def run_git(args: list[str], cwd: Path = ROOT) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", *args],
        cwd=cwd,
        text=True,
        capture_output=True,
        timeout=10,
        check=False,
    )


def classify_path(path: str, status: str) -> list[str]:
    classifications: list[str] = []
    lower = path.lower()
    if status == "A":
        classifications.append("new-subsystem")
    if status == "D":
        classifications.append("deleted-subsystem")
    if lower.endswith(".md") or lower.startswith("docs/") or lower.startswith("agent/"):
        classifications.append("docs-only")
    if lower.startswith("tests/") or "/test_" in lower or lower.endswith("_test.py"):
        classifications.append("tests-only")
    if lower in {"pyproject.toml", "package.json", "package-lock.json", "requirements.txt"} or lower.endswith(".lock"):
        classifications.append("dependency-config")
    if lower == "repo-review" or lower.startswith("tools/"):
        classifications.append("core-logic")
    if lower.startswith("schemas/"):
        classifications.append("architecture-boundary")
    return classifications or ["core-logic"]


def diff_command(options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    diff_range = options.get("range")
    if not diff_range:
        return fail(
            "missing required --range",
            "Run: repo-review diff --range <from>..<to> --json --no-input",
            valid_values=["--range"],
        ), None

    try:
        limit = int(options.get("limit") or 50)
    except ValueError:
        return fail("invalid --limit", "Use a positive integer for --limit.", valid_values=["1", "10", "50"]), None
    if limit < 1:
        return fail("invalid --limit", "Use a positive integer for --limit.", valid_values=["1", "10", "50"]), None

    repo_root = Path(options.get("repo") or ROOT).expanduser().resolve()
    if not (repo_root / ".git").exists():
        return fail(
            "repo path is not a git checkout",
            "Pass --repo <path> pointing at a git repository.",
            code=4,
            error_code="resource_not_found",
            valid_values=["--repo"],
        ), None

    path_filter = options.get("path")
    pathspec = ["--", path_filter] if path_filter else []
    status_result = run_git(["diff", "--name-status", diff_range, *pathspec], cwd=repo_root)
    if status_result.returncode != 0:
        return fail(
            "git diff --name-status failed",
            status_result.stderr.strip() or "Check that the supplied --range is valid.",
            code=6,
            error_code="external_command_failed",
        ), None
    numstat_result = run_git(["diff", "--numstat", diff_range, *pathspec], cwd=repo_root)
    if numstat_result.returncode != 0:
        return fail(
            "git diff --numstat failed",
            numstat_result.stderr.strip() or "Check that the supplied --range is valid.",
            code=6,
            error_code="external_command_failed",
        ), None

    stats_by_path: dict[str, tuple[int, int]] = {}
    for line in numstat_result.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) < 3:
            continue
        additions = 0 if parts[0] == "-" else int(parts[0])
        deletions = 0 if parts[1] == "-" else int(parts[1])
        stats_by_path[parts[2]] = (additions, deletions)

    changed_files: list[dict[str, Any]] = []
    status_map = {
        "A": "added",
        "M": "modified",
        "D": "deleted",
        "R": "renamed",
        "C": "copied",
        "T": "type_changed",
    }
    for line in status_result.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) < 2:
            continue
        status_code = parts[0][0]
        path = parts[-1]
        additions, deletions = stats_by_path.get(path, (0, 0))
        changed_files.append(
            {
                "path": path,
                "status": status_map.get(status_code, "unknown"),
                "additions": additions,
                "deletions": deletions,
                "classifications": classify_path(path, status_code),
                "summary": f"{status_map.get(status_code, 'unknown')} file with {additions} additions and {deletions} deletions",
            }
        )

    total_files = len(changed_files)
    shown_files = changed_files[:limit]
    truncated = total_files > len(shown_files)
    return 0, {
        "schema_version": SCHEMA_VERSION,
        "repo": {
            "name": repo_root.name,
            "root": str(repo_root),
            "remote": run_git(["remote", "get-url", "origin"], cwd=repo_root).stdout.strip() or None,
        },
        "range": {
            "expression": diff_range,
            "from_commit": diff_range.split("..", 1)[0] if ".." in diff_range else "",
            "to_commit": diff_range.split("..", 1)[1] if ".." in diff_range else "",
        },
        "produced_by_analyzer": {
            "id": "repo-review-cli",
            "kind": "tool",
            "model": None,
            "tool_context": "repo-review diff",
        },
        "summary_stats": {
            "files_changed": total_files,
            "additions": sum(file["additions"] for file in changed_files),
            "deletions": sum(file["deletions"] for file in changed_files),
        },
        "changed_files": shown_files,
        "truncation": {
            "limit": limit,
            "shown": len(shown_files),
            "total": total_files,
            "truncated": truncated,
            "narrowing_hints": ["Use --path <path> to filter changed files.", "Use --limit <n> to raise or lower the bound."] if truncated else [],
        },
        "unknowns": [],
    }


def load_json_file(path_value: str | None, label: str) -> tuple[dict[str, Any] | None, int]:
    if not path_value:
        return None, fail(
            f"missing required --{label}",
            f"Run with --{label} <path>.",
            valid_values=[f"--{label}"],
        )
    path = Path(path_value)
    if not path.is_file():
        return None, fail(
            f"{label} file was not found",
            f"Expected a readable JSON file at {path}.",
            code=4,
            error_code="resource_not_found",
        )
    try:
        with path.open(encoding="utf-8") as handle:
            return json.load(handle), 0
    except json.JSONDecodeError as exc:
        return None, fail(
            f"{label} is not valid JSON",
            f"{exc.msg} at line {exc.lineno}, column {exc.colno}.",
            code=3,
            error_code="validation_failed",
        )


def option_values(options: dict[str, Any], key: str) -> list[str]:
    value = options.get(key)
    if value in (None, ""):
        return []
    if isinstance(value, list):
        return [item for item in value if item not in (None, "")]
    return [value]


def add_count(counts: dict[str, int], key: str | None) -> None:
    counts[key or "unknown"] = counts.get(key or "unknown", 0) + 1


def path_matches(pattern: str, path: str) -> bool:
    if fnmatch(path, pattern):
        return True
    if "*" not in pattern and not pattern.endswith("/") and path.startswith(pattern.rstrip("/") + "/"):
        return True
    return False


def impact_command(options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    review_state, code = load_json_file(options.get("review_state"), "review-state")
    if code != 0:
        return code, None
    diff_report, code = load_json_file(options.get("diff_report"), "diff-report")
    if code != 0:
        return code, None
    assert review_state is not None
    assert diff_report is not None

    claims = review_state.get("claims", [])
    changed_files = diff_report.get("changed_files", [])
    path_hits: list[dict[str, Any]] = []
    impacted_ids: set[str] = set()
    matched_files: set[str] = set()

    for claim in claims:
        claim_id = claim.get("id")
        watch_paths = claim.get("watch_paths", [])
        matches: list[str] = []
        for changed in changed_files:
            changed_path = changed.get("path", "")
            if any(path_matches(pattern, changed_path) for pattern in watch_paths):
                matches.append(changed_path)
                matched_files.add(changed_path)
        if matches and claim_id:
            path_hits.append({"claim_id": claim_id, "matched_paths": sorted(set(matches))})
            impacted_ids.add(claim_id)

    trigger_hits = diff_report.get("trigger_hits", [])
    for hit in trigger_hits:
        claim_id = hit.get("claim_id")
        if claim_id:
            impacted_ids.add(claim_id)

    impacted_claims: list[dict[str, Any]] = []
    for claim_id in sorted(impacted_ids):
        surfaced_by = []
        if any(hit["claim_id"] == claim_id for hit in path_hits):
            surfaced_by.append("path_hit")
        if any(hit.get("claim_id") == claim_id for hit in trigger_hits):
            surfaced_by.append("trigger_hit")
        impacted_claims.append(
            {
                "claim_id": claim_id,
                "impact": "unknown",
                "surfaced_by": surfaced_by or ["unknown"],
                "reason": "Claim surfaced by " + ", ".join(surfaced_by or ["unknown mapping"]) + ".",
                "required_followup_passes": ["trace"],
            }
        )

    unaffected_claims = [
        {
            "claim_id": claim.get("id"),
            "reason": "No changed file matched watch_paths and no trigger hit was supplied.",
        }
        for claim in claims
        if claim.get("id") not in impacted_ids
    ]

    unknowns = list(diff_report.get("unknowns", []))
    for changed in changed_files:
        changed_path = changed.get("path")
        if changed_path and changed_path not in matched_files:
            unknowns.append(
                {
                    "changed_file": changed_path,
                    "classification": ",".join(changed.get("classifications", [])),
                    "reason": "No claim watch_path matched this changed file; semantic trigger evaluation may still be needed.",
                }
            )

    return 0, {
        "schema_version": SCHEMA_VERSION,
        "from_review": review_state.get("id"),
        "to_repo_commit": diff_report.get("range", {}).get("to_commit"),
        "diff_range": diff_report.get("range", {}).get("expression"),
        "path_hits": path_hits,
        "trigger_hits": trigger_hits,
        "impacted_claims": impacted_claims,
        "unaffected_claims": unaffected_claims,
        "unknowns": unknowns,
    }


def compact_json(data: dict[str, Any]) -> str:
    return json.dumps(data, indent=2, sort_keys=True)


def build_delta_prompt(review_state: dict[str, Any], diff_report: dict[str, Any], impact_plan: dict[str, Any]) -> str:
    impacted = impact_plan.get("impacted_claims", [])
    return "\n".join(
        [
            "# Delta Trace Prompt Packet",
            "",
            "You are updating an existing repo-review state. Do not rerun a full review.",
            "",
            "## Required Output",
            "",
            "- Include `produced_by_analyzer` with analyzer identity.",
            "- Update only claims surfaced by the impact plan unless new evidence requires a new claim.",
            "- Label each meaningful update as `subject_drift`, `analysis_drift`, or `both`.",
            "- Preserve contested or uncertain claims instead of silently adjudicating them.",
            "",
            "## Conflation Guard",
            "",
            "Keep intra-review delta, inter-version delta, analysis drift, and subject drift separate. A corrected interpretation of unchanged evidence is analysis drift, not proof that the repo changed.",
            "",
            "## Impact Summary",
            "",
            f"Impacted claims: {len(impacted)}",
            f"Unknowns: {len(impact_plan.get('unknowns', []))}",
            "",
            "## Prior Review State",
            "",
            "```json",
            compact_json(review_state),
            "```",
            "",
            "## Diff Report",
            "",
            "```json",
            compact_json(diff_report),
            "```",
            "",
            "## Impact Plan",
            "",
            "```json",
            compact_json(impact_plan),
            "```",
            "",
        ]
    )


def export_prompt_command(options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    pass_id = options.get("pass")
    if pass_id != "delta-trace":
        return fail(
            "unsupported or missing --pass",
            "Run: repo-review export-prompt --pass delta-trace --output <path> --json --no-input",
            valid_values=["delta-trace"],
        ), None
    deliver = options.get("deliver")
    output = options.get("output")
    if deliver:
        if deliver == "stdout":
            output = None
        elif deliver.startswith("file:"):
            output = deliver.removeprefix("file:")
            if not output:
                return fail("missing file delivery path", "Use --deliver=file:<path>.", valid_values=["file:<path>"]), None
        elif deliver.startswith("webhook:"):
            return fail(
                "webhook delivery is deferred in v1",
                "Use --deliver=stdout or --deliver=file:<path>.",
                code=2,
                valid_values=["stdout", "file:<path>"],
            ), None
        else:
            return fail("unsupported delivery scheme", "Use stdout or file:<path>.", valid_values=["stdout", "file:<path>"]), None
    if not output and deliver != "stdout":
        return fail("missing required --output", "Run with --output <path> or --deliver=stdout.", valid_values=["--output", "--deliver=stdout"]), None

    required_inputs = ["review-state", "diff-report", "impact-plan"]
    if options.get("dry_run"):
        return 0, {
            "schema_version": SCHEMA_VERSION,
            "dry_run": True,
            "would_write": None if deliver == "stdout" else str(Path(output)),
            "delivery": deliver or f"file:{output}",
            "delivery_metadata": {
                "scheme": "stdout" if deliver == "stdout" else "file",
                "path": None if deliver == "stdout" else str(Path(output)),
                "webhook_deferred": False,
            },
            "required_inputs": required_inputs,
            "missing_inputs": [name for name in required_inputs if not options.get(name.replace("-", "_"))],
        }

    review_state, code = load_json_file(options.get("review_state"), "review-state")
    if code != 0:
        return code, None
    diff_report, code = load_json_file(options.get("diff_report"), "diff-report")
    if code != 0:
        return code, None
    impact_plan, code = load_json_file(options.get("impact_plan"), "impact-plan")
    if code != 0:
        return code, None
    assert review_state is not None
    assert diff_report is not None
    assert impact_plan is not None

    prompt = build_delta_prompt(review_state, diff_report, impact_plan)
    if deliver == "stdout":
        return 0, {
            "schema_version": SCHEMA_VERSION,
            "delivery": "stdout",
            "delivery_metadata": {
                "scheme": "stdout",
                "path": None,
                "webhook_deferred": False,
            },
            "artifact": prompt,
            "bytes_written": 0,
            "pass": pass_id,
            "overwritten": False,
        }

    output_path = Path(output)
    if output_path.exists() and not options.get("overwrite"):
        return fail(
            "output path already exists",
            "Add --overwrite to replace the existing prompt packet.",
            code=5,
            error_code="unsafe_mutation_refused",
            valid_values=["--overwrite"],
        ), None
    output_path.parent.mkdir(parents=True, exist_ok=True)
    temp_path = output_path.with_suffix(output_path.suffix + ".tmp")
    temp_path.write_text(prompt, encoding="utf-8")
    temp_path.replace(output_path)
    return 0, {
        "schema_version": SCHEMA_VERSION,
        "path": str(output_path),
        "delivery": f"file:{output_path}",
        "delivery_metadata": {
            "scheme": "file",
            "path": str(output_path),
            "webhook_deferred": False,
        },
        "bytes_written": output_path.stat().st_size,
        "pass": pass_id,
        "overwritten": bool(options.get("overwrite")),
    }


def required_delta_inputs(options: dict[str, Any]) -> tuple[list[str], list[str]]:
    required = ["review-state", "diff-report", "impact-plan", "output"]
    missing = [name for name in required if not options.get(name.replace("-", "_"))]
    return required, missing


def next_command(options: dict[str, Any]) -> dict[str, Any]:
    required, missing = required_delta_inputs(options)
    output = options.get("output") or "reviews/<repo>/delta-<date>/delta-trace-prompt.md"
    if missing:
        next_action = "collect_delta_inputs"
        recommended = "repo-review diff --range <from>..<to> --json --no-input > diff-report.json"
    else:
        next_action = "export_delta_prompt"
        recommended = (
            "repo-review export-prompt --pass delta-trace "
            f"--review-state {options['review_state']} --diff-report {options['diff_report']} "
            f"--impact-plan {options['impact_plan']} --output {output} --json --no-input"
        )
    return {
        "schema_version": SCHEMA_VERSION,
        "next_action": next_action,
        "required_inputs": required,
        "missing_inputs": missing,
        "write_output_to": output,
        "recommended_command": recommended,
    }


def ingest_command(options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    input_path_value = options.get("input")
    kind = options.get("kind") or "external-analyzer-output"
    if not input_path_value:
        return fail("missing required --input", "Run: repo-review ingest --input <path> --json --no-input", valid_values=["--input"]), None
    input_path = Path(input_path_value)
    if not input_path.is_file():
        return fail("input artifact was not found", f"Expected readable file at {input_path}.", code=4, error_code="resource_not_found"), None
    text = input_path.read_text(encoding="utf-8")
    if kind == "delta-review" and "delta_review:" not in text:
        return fail(
            "delta-review artifact is missing structured appendix",
            "Expected a delta_review: block in the analyzer output.",
            code=3,
            error_code="validation_failed",
            valid_values=["delta-review"],
        ), None
    STATE_DIR.mkdir(exist_ok=True)
    created_at = datetime.now(timezone.utc).replace(microsecond=0).isoformat()
    entry_id = "ingest-" + created_at.replace(":", "").replace("+", "Z")
    entry = {
        "schema_version": SCHEMA_VERSION,
        "entry_id": entry_id,
        "created_at": created_at,
        "kind": kind,
        "input": str(input_path),
        "bytes": input_path.stat().st_size,
    }
    with INGEST_PATH.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(entry, sort_keys=True) + "\n")
    return 0, {"schema_version": SCHEMA_VERSION, "entry_id": entry_id, "path": str(INGEST_PATH), "record": entry}


def delta_command(options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    if options.get("wait"):
        return fail(
            "analysis execution is deferred in v1",
            "repo-review delta assembles prompt-packet workflow metadata; do not use --wait until jobs ship.",
            code=2,
            valid_values=["omit --wait"],
        ), None
    return 0, {
        "schema_version": SCHEMA_VERSION,
        "orchestration_model": "prompt-packet-only",
        "executes_analysis": False,
        "jobs_required": False,
        "jobs_deferred": True,
        **next_command(options),
    }


def qualify_claim_id(review_state_id: str, claim_id: str) -> str:
    return claim_id if ":" in claim_id else f"{review_state_id}:{claim_id}"


def claims_command(positionals: list[str], options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    if not positionals:
        return fail("missing claims subcommand", "Use one of: list, get, affected.", valid_values=["list", "get", "affected"]), None
    subcommand, *rest = positionals

    if subcommand == "affected":
        impact_plan, code = load_json_file(options.get("impact_plan"), "impact-plan")
        if code != 0:
            return code, None
        assert impact_plan is not None
        from_review = impact_plan.get("from_review")
        affected = [
            {
                **claim,
                "qualified_claim_id": qualify_claim_id(from_review, claim.get("claim_id", "")),
            }
            for claim in impact_plan.get("impacted_claims", [])
        ]
        return 0, {"schema_version": SCHEMA_VERSION, "from_review": from_review, "affected_claims": affected}

    review_state, code = load_json_file(options.get("review_state"), "review-state")
    if code != 0:
        return code, None
    assert review_state is not None
    review_state_id = review_state.get("id")
    claims = list(review_state.get("claims", []))

    if subcommand == "list":
        if options.get("claim_status"):
            claims = [claim for claim in claims if claim.get("claim_status") == options["claim_status"]]
        if options.get("kind"):
            claims = [claim for claim in claims if claim.get("kind") == options["kind"]]
        if options.get("subject"):
            claims = [claim for claim in claims if claim.get("subject", {}).get("ref") == options["subject"]]
        try:
            limit = int(options.get("limit") or 20)
        except ValueError:
            return fail("invalid --limit", "Use a positive integer for --limit.", valid_values=["1", "20", "50"]), None
        shown = claims[:limit]
        return 0, {
            "schema_version": SCHEMA_VERSION,
            "review_state": review_state_id,
            "claims": [
                {
                    "qualified_claim_id": qualify_claim_id(review_state_id, claim["id"]),
                    "id": claim["id"],
                    "kind": claim.get("kind"),
                    "claim_status": claim.get("claim_status"),
                    "subject": claim.get("subject"),
                    "statement": claim.get("statement"),
                }
                for claim in shown
            ],
            "truncation": {
                "limit": limit,
                "shown": len(shown),
                "total": len(claims),
                "truncated": len(claims) > len(shown),
            },
        }

    if subcommand == "get":
        if not rest:
            return fail("missing claim id", "Run: repo-review claims get <id> --review-state <path> --json --no-input"), None
        requested = rest[0].split(":", 1)[1] if ":" in rest[0] else rest[0]
        for claim in claims:
            if claim.get("id") == requested:
                return 0, {
                    "schema_version": SCHEMA_VERSION,
                    "review_state": review_state_id,
                    "qualified_claim_id": qualify_claim_id(review_state_id, claim["id"]),
                    "claim": claim,
                }
        return fail("claim was not found", f"No claim '{rest[0]}' exists in review state {review_state_id}.", code=4, error_code="resource_not_found"), None

    return fail(f"unknown claims subcommand '{subcommand}'", "Use one of: list, get, affected.", valid_values=["list", "get", "affected"]), None


def analyzer_key(analyzer: dict[str, Any]) -> str:
    return "|".join(
        str(analyzer.get(field) or "")
        for field in ("id", "kind", "model", "tool_context")
    )


def collect_analyzers(review_state: dict[str, Any]) -> list[dict[str, Any]]:
    analyzers: dict[str, dict[str, Any]] = {}
    candidates = [review_state.get("produced_by_analyzer")]
    candidates.extend(output.get("produced_by_analyzer") for output in review_state.get("pass_outputs", []))
    candidates.extend(claim.get("produced_by_analyzer") for claim in review_state.get("claims", []))
    for analyzer in candidates:
        if isinstance(analyzer, dict):
            analyzers[analyzer_key(analyzer)] = {
                "id": analyzer.get("id"),
                "kind": analyzer.get("kind"),
                "model": analyzer.get("model"),
                "tool_context": analyzer.get("tool_context"),
            }
    return sorted(analyzers.values(), key=lambda item: (str(item.get("id")), str(item.get("tool_context"))))


def aggregate_command(options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    review_state_paths = option_values(options, "review_state")
    if not review_state_paths:
        return fail(
            "missing required --review-state",
            "Run: repo-review aggregate --review-state <path> --review-state <path> --json --no-input",
            valid_values=["--review-state"],
        ), None
    try:
        limit = int(options.get("limit") or 10)
    except (TypeError, ValueError):
        return fail("invalid --limit", "Use a positive integer for --limit.", valid_values=["1", "10", "50"]), None

    review_summaries: list[dict[str, Any]] = []
    total_claim_status_counts: dict[str, int] = {}
    total_kind_counts: dict[str, int] = {}
    analyzers_by_key: dict[str, dict[str, Any]] = {}

    for index, path_value in enumerate(review_state_paths, start=1):
        review_state, code = load_json_file(path_value, f"review-state {index}")
        if code != 0:
            return code, None
        assert review_state is not None
        review_state_id = review_state.get("id")
        claims = list(review_state.get("claims", []))
        claim_status_counts: dict[str, int] = {}
        kind_counts: dict[str, int] = {}
        for claim in claims:
            add_count(claim_status_counts, claim.get("claim_status"))
            add_count(total_claim_status_counts, claim.get("claim_status"))
            add_count(kind_counts, claim.get("kind"))
            add_count(total_kind_counts, claim.get("kind"))

        analyzers = collect_analyzers(review_state)
        for analyzer in analyzers:
            key = analyzer_key(analyzer)
            existing = analyzers_by_key.setdefault(
                key,
                {
                    **analyzer,
                    "review_states": [],
                },
            )
            existing["review_states"].append(review_state_id)

        drift_surface = review_state.get("drift_surface") or {}
        review_summaries.append(
            {
                "path": path_value,
                "id": review_state_id,
                "repo": review_state.get("repo", {}).get("name"),
                "mode": review_state.get("mode"),
                "claim_count": len(claims),
                "claim_status_counts": dict(sorted(claim_status_counts.items())),
                "claim_kind_counts": dict(sorted(kind_counts.items())),
                "analyzers": analyzers,
                "drift_surface_counts": {
                    "snapshot_entries": len(drift_surface.get("snapshot_entries", [])),
                    "fascination_seeds": len(drift_surface.get("fascination_seeds", [])),
                },
                "sample_qualified_claim_ids": [
                    qualify_claim_id(review_state_id, claim.get("id", ""))
                    for claim in claims[: max(limit, 0)]
                ],
            }
        )

    drift_counts = {
        "new_snapshot_entries": 0,
        "invalidated_snapshot_entries": 0,
        "strengthened_fascination_seeds": 0,
        "weakened_fascination_seeds": 0,
        "new_fascination_seeds": 0,
        "lane_impacts": 0,
    }
    drift_outputs: list[dict[str, Any]] = []
    for index, path_value in enumerate(option_values(options, "drift"), start=1):
        drift, code = load_json_file(path_value, f"drift {index}")
        if code != 0:
            return code, None
        assert drift is not None
        for key in drift_counts:
            drift_counts[key] += len(drift.get(key, []))
        drift_outputs.append(
            {
                "path": path_value,
                "repo": drift.get("repo"),
                "from_review": drift.get("from_review"),
                "to_review": drift.get("to_review"),
                "diff_range": drift.get("diff_range"),
            }
        )

    analyzers = sorted(analyzers_by_key.values(), key=lambda item: (str(item.get("id")), str(item.get("tool_context"))))
    return 0, {
        "schema_version": SCHEMA_VERSION,
        "review_state_count": len(review_summaries),
        "review_states": review_summaries,
        "totals": {
            "claim_count": sum(item["claim_count"] for item in review_summaries),
            "claim_status_counts": dict(sorted(total_claim_status_counts.items())),
            "claim_kind_counts": dict(sorted(total_kind_counts.items())),
            "analyzer_count": len(analyzers),
            "drift_output_count": len(drift_outputs),
        },
        "analyzers": analyzers,
        "drift_material": {
            "outputs": drift_outputs,
            "counts": drift_counts,
        },
        "claim_identity": {
            "global_claim_identity_supported": False,
            "qualified_id_required": True,
            "scope": "Claim IDs are local to each review_state; aggregation never merges same-named claims across reviews.",
        },
    }


def drift_command(positionals: list[str], options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    if not positionals or positionals[0] != "surface":
        return fail(
            "missing or unsupported drift subcommand",
            "Run: repo-review drift surface --review-state <path> --diff-report <path> --impact-plan <path> --json --no-input",
            valid_values=["surface"],
        ), None
    review_state, code = load_json_file(options.get("review_state"), "review-state")
    if code != 0:
        return code, None
    diff_report, code = load_json_file(options.get("diff_report"), "diff-report")
    if code != 0:
        return code, None
    impact_plan, code = load_json_file(options.get("impact_plan"), "impact-plan")
    if code != 0:
        return code, None
    assert review_state is not None
    assert diff_report is not None
    assert impact_plan is not None

    from_review = review_state.get("id")
    to_review = options.get("to_review") or f"{from_review}-delta"
    impacted = impact_plan.get("impacted_claims", [])
    unknowns = impact_plan.get("unknowns", [])
    return 0, {
        "schema_version": SCHEMA_VERSION,
        "repo": review_state.get("repo", {}).get("name"),
        "from_review": from_review,
        "to_review": to_review,
        "diff_range": diff_report.get("range", {}).get("expression"),
        "produced_by_analyzer": {
            "id": "repo-review-cli",
            "kind": "tool",
            "model": None,
            "tool_context": "repo-review drift surface",
        },
        "new_snapshot_entries": [
            {
                "reason": "Diff contains unknown changed files that may require new review observations.",
                "source_claim": item.get("claim_id"),
                "changed_file": item.get("changed_file"),
            }
            for item in unknowns
        ],
        "invalidated_snapshot_entries": [
            {
                "source_claim": item.get("claim_id"),
                "reason": item.get("reason", "Impacted claim may be invalidated by the diff."),
            }
            for item in impacted
            if item.get("impact") == "possibly_invalidated"
        ],
        "strengthened_fascination_seeds": [
            {
                "source_claim": item.get("claim_id"),
                "reason": item.get("reason", "Impacted claim may be strengthened by the diff."),
            }
            for item in impacted
            if item.get("impact") == "possibly_strengthened"
        ],
        "weakened_fascination_seeds": [
            {
                "source_claim": item.get("claim_id"),
                "reason": item.get("reason", "Impacted claim needs delta review; treating as possibly weakened until analyzed."),
            }
            for item in impacted
            if item.get("impact") in {"possibly_weakened", "unknown"}
        ],
        "new_fascination_seeds": [
            {
                "reason": "Unknown changed material may produce a new fascination seed after analyst review.",
                "changed_file": item.get("changed_file"),
            }
            for item in unknowns
        ],
        "lane_impacts": [
            {
                "lane": "repo-review",
                "impact": "unknown" if impacted or unknowns else "unchanged",
                "reason": "Delta impact is derived from the impact plan and awaits analyzer review.",
            }
        ],
    }


def resolve_config(options: dict[str, Any]) -> dict[str, Any]:
    profiles = load_profiles()
    selected_profile = options.get("profile")
    profile = profiles.get(selected_profile, {}) if selected_profile else {}

    fields = {
        "repo_root": {
            "flag": "repo",
            "env": "REPO_REVIEW_REPO",
            "profile": "repo_root",
            "default": str(ROOT),
        },
        "review_output_dir": {
            "flag": "output",
            "env": "REPO_REVIEW_OUTPUT",
            "profile": "review_output_dir",
            "default": str(ROOT / "reviews"),
        },
        "analyzer_id": {
            "flag": "analyzer_id",
            "env": "REPO_REVIEW_ANALYZER_ID",
            "profile": "analyzer_id",
            "default": "unknown",
        },
        "lane_vocabulary_path": {
            "flag": "lane_vocabulary",
            "env": "REPO_REVIEW_LANE_VOCABULARY",
            "profile": "lane_vocabulary_path",
            "default": None,
        },
        "output_mode": {
            "flag": "output_mode",
            "env": "REPO_REVIEW_OUTPUT_MODE",
            "profile": "output_mode",
            "default": "json",
        },
    }

    configured: dict[str, Any] = {}
    sources: dict[str, str] = {}
    for field, spec in fields.items():
        flag_name = spec["flag"]
        if options.get(flag_name) not in (None, ""):
            configured[field] = options[flag_name]
            sources[field] = "flag"
        elif os.environ.get(spec["env"]):
            configured[field] = os.environ[spec["env"]]
            sources[field] = "environment"
        elif profile.get(spec["profile"]) not in (None, ""):
            configured[field] = profile[spec["profile"]]
            sources[field] = "profile"
        else:
            configured[field] = spec["default"]
            sources[field] = "default"

    return {
        "profile": selected_profile,
        "configured_paths": configured,
        "sources": sources,
    }


def status(options: dict[str, Any]) -> dict[str, Any]:
    config = resolve_config(options)
    return {
        "schema_version": SCHEMA_VERSION,
        **config,
        "available_profiles": profile_names(),
        "next_actions": [
            {
                "action": "run_first_read",
                "reason": "No review-state discovery is implemented in this CLI slice.",
                "recommended_command": "repo-review skill-path --json",
            }
        ],
    }


def profile_command(positionals: list[str], options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    if not positionals:
        values = ["list", "show", "save", "delete"]
        return fail("missing profile subcommand", "Use one of: list, show, save, delete.", valid_values=values), None
    subcommand, *rest = positionals
    profiles = load_profiles()

    if subcommand == "list":
        return 0, {"schema_version": SCHEMA_VERSION, "profiles": sorted(profiles)}

    if subcommand == "show":
        if not rest:
            return fail("missing profile name", "Run: repo-review profile show <name> --json"), None
        name = rest[0]
        if name not in profiles:
            values = sorted(profiles)
            return fail(
                f"profile '{name}' was not found",
                f"Use one of: {', '.join(values) or '(none)'}.",
                code=4,
                error_code="resource_not_found",
                valid_values=values,
            ), None
        return 0, {"schema_version": SCHEMA_VERSION, "name": name, "profile": profiles[name]}

    if subcommand == "save":
        if not rest:
            return fail("missing profile name", "Run: repo-review profile save <name> --repo <path> --output <path> --json --no-input"), None
        name = rest[0]
        profile = {
            "repo_root": options.get("repo") or str(ROOT),
            "review_output_dir": options.get("output") or str(ROOT / "reviews"),
            "analyzer_id": options.get("analyzer_id") or "unknown",
            "lane_vocabulary_path": options.get("lane_vocabulary"),
            "output_mode": options.get("output_mode") or "json",
        }
        profiles[name] = profile
        save_profiles(profiles)
        return 0, {"schema_version": SCHEMA_VERSION, "name": name, "profile": profile, "path": str(PROFILES_PATH)}

    if subcommand == "delete":
        if not rest:
            return fail("missing profile name", "Run: repo-review profile delete <name> --force --json --no-input"), None
        if not options.get("force"):
            return fail(
                "unsafe mutation refused",
                "Add --force to delete a profile.",
                code=5,
                error_code="unsafe_mutation_refused",
                valid_values=["--force"],
            ), None
        name = rest[0]
        existed = name in profiles
        profiles.pop(name, None)
        save_profiles(profiles)
        return 0, {"schema_version": SCHEMA_VERSION, "name": name, "deleted": existed, "path": str(PROFILES_PATH)}

    values = ["list", "show", "save", "delete"]
    return fail(f"unknown profile subcommand '{subcommand}'", "Use one of: list, show, save, delete.", valid_values=values), None


def feedback(positionals: list[str]) -> dict[str, Any] | tuple[int, None]:
    if not positionals:
        return fail("missing feedback message", "Run: repo-review feedback \"message\" --json --no-input"), None
    STATE_DIR.mkdir(exist_ok=True)
    created_at = datetime.now(timezone.utc).replace(microsecond=0).isoformat()
    entry_id = "feedback-" + created_at.replace(":", "").replace("+", "Z")
    entry = {
        "schema_version": SCHEMA_VERSION,
        "entry_id": entry_id,
        "created_at": created_at,
        "message": " ".join(positionals),
    }
    with FEEDBACK_PATH.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(entry, sort_keys=True) + "\n")
    return {"schema_version": SCHEMA_VERSION, "entry_id": entry_id, "path": str(FEEDBACK_PATH)}


def main(argv: list[str]) -> int:
    if not argv or argv[0] in {"-h", "--help"}:
        commands = ", ".join(sorted(COMMANDS))
        return fail(
            "missing command",
            f"Use one of: {commands}. Example: repo-review agent-context --json",
            valid_values=sorted(COMMANDS),
        )

    command, *args = argv
    if command not in COMMANDS:
        commands = ", ".join(sorted(COMMANDS))
        return fail(f"unknown command '{command}'", f"Use one of: {commands}.", valid_values=sorted(COMMANDS))

    if not require_json(args):
        return fail(
            f"{command} requires --json in the current CLI slice",
            f"Run: repo-review {command} --json",
        )

    positionals, options = parse_args(args)

    if command == "agent-context":
        return emit_json(agent_context())
    if command == "diff":
        code, payload = diff_command(options)
        if code != 0:
            return code
        return emit_json(payload or {})
    if command == "delta":
        code, payload = delta_command(options)
        if code != 0:
            return code
        return emit_json(payload or {})
    if command == "aggregate":
        code, payload = aggregate_command(options)
        if code != 0:
            return code
        return emit_json(payload or {})
    if command == "claims":
        code, payload = claims_command(positionals, options)
        if code != 0:
            return code
        return emit_json(payload or {})
    if command == "drift":
        code, payload = drift_command(positionals, options)
        if code != 0:
            return code
        return emit_json(payload or {})
    if command == "feedback":
        result = feedback(positionals)
        if isinstance(result, tuple):
            code, _ = result
            return code
        return emit_json(result)
    if command == "export-prompt":
        code, payload = export_prompt_command(options)
        if code != 0:
            return code
        return emit_json(payload or {})
    if command == "impact":
        code, payload = impact_command(options)
        if code != 0:
            return code
        return emit_json(payload or {})
    if command == "ingest":
        code, payload = ingest_command(options)
        if code != 0:
            return code
        return emit_json(payload or {})
    if command == "next":
        return emit_json(next_command(options))
    if command == "profile":
        code, payload = profile_command(positionals, options)
        if code != 0:
            return code
        return emit_json(payload or {})
    if command == "skill-path":
        if not MANIFEST_DIR.is_dir() or not MANIFEST_PATH.is_file():
            return fail(
                "skill manifest is missing",
                f"Expected readable manifest at {MANIFEST_PATH}.",
                code=4,
                error_code="resource_not_found",
            )
        return emit_json(skill_path())
    if command == "status":
        return emit_json(status(options))

    return fail(f"command '{command}' is registered but not implemented", "Check agent-context for shipped commands.", code=1)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
