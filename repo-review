def run_git(args: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", *args],
        cwd=ROOT,
        text=True,
        capture_output=True,
        timeout=10,
        check=False,
    )


def classify_path(path: str, status: str) -> list[str]:
    classifications: list[str] = []
    lower = path.lower()
    if status == "A":
        classifications.append("new-subsystem")
    if status == "D":
        classifications.append("deleted-subsystem")
    if lower.endswith(".md") or lower.startswith("docs/") or lower.startswith("agent/"):
        classifications.append("docs-only")
    if lower.startswith("tests/") or "/test_" in lower or lower.endswith("_test.py"):
        classifications.append("tests-only")
    if lower in {"pyproject.toml", "package.json", "package-lock.json", "requirements.txt"} or lower.endswith(".lock"):
        classifications.append("dependency-config")
    if lower == "repo-review" or lower.startswith("tools/"):
        classifications.append("core-logic")
    if lower.startswith("schemas/"):
        classifications.append("architecture-boundary")
    return classifications or ["core-logic"]


def diff_command(options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    diff_range = options.get("range")
    if not diff_range:
        return fail(
            "missing required --range",
            "Run: repo-review diff --range <from>..<to> --json --no-input",
            valid_values=["--range"],
        ), None

    try:
        limit = int(options.get("limit") or 50)
    except ValueError:
        return fail("invalid --limit", "Use a positive integer for --limit.", valid_values=["1", "10", "50"]), None
    if limit < 1:
        return fail("invalid --limit", "Use a positive integer for --limit.", valid_values=["1", "10", "50"]), None

    path_filter = options.get("path")
    pathspec = ["--", path_filter] if path_filter else []
    status_result = run_git(["diff", "--name-status", diff_range, *pathspec])
    if status_result.returncode != 0:
        return fail(
            "git diff --name-status failed",
            status_result.stderr.strip() or "Check that the supplied --range is valid.",
            code=6,
            error_code="external_command_failed",
        ), None
    numstat_result = run_git(["diff", "--numstat", diff_range, *pathspec])
    if numstat_result.returncode != 0:
        return fail(
            "git diff --numstat failed",
            numstat_result.stderr.strip() or "Check that the supplied --range is valid.",
            code=6,
            error_code="external_command_failed",
        ), None

    stats_by_path: dict[str, tuple[int, int]] = {}
    for line in numstat_result.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) < 3:
            continue
        additions = 0 if parts[0] == "-" else int(parts[0])
        deletions = 0 if parts[1] == "-" else int(parts[1])
        stats_by_path[parts[2]] = (additions, deletions)

    changed_files: list[dict[str, Any]] = []
    status_map = {
        "A": "added",
        "M": "modified",
        "D": "deleted",
        "R": "renamed",
        "C": "copied",
        "T": "type_changed",
    }
    for line in status_result.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) < 2:
            continue
        status_code = parts[0][0]
        path = parts[-1]
        additions, deletions = stats_by_path.get(path, (0, 0))
        changed_files.append(
            {
                "path": path,
                "status": status_map.get(status_code, "unknown"),
                "additions": additions,
                "deletions": deletions,
                "classifications": classify_path(path, status_code),
                "summary": f"{status_map.get(status_code, 'unknown')} file with {additions} additions and {deletions} deletions",
            }
        )

    total_files = len(changed_files)
    shown_files = changed_files[:limit]
    truncated = total_files > len(shown_files)
    return 0, {
        "schema_version": SCHEMA_VERSION,
        "repo": {
            "name": ROOT.name,
            "root": str(ROOT),
            "remote": run_git(["remote", "get-url", "origin"]).stdout.strip() or None,
        },
        "range": {
            "expression": diff_range,
            "from_commit": diff_range.split("..", 1)[0] if ".." in diff_range else "",
            "to_commit": diff_range.split("..", 1)[1] if ".." in diff_range else "",
        },
        "produced_by_analyzer": {
            "id": "repo-review-cli",
            "kind": "tool",
            "model": None,
            "tool_context": "repo-review diff",
        },
        "summary_stats": {
            "files_changed": total_files,
            "additions": sum(file["additions"] for file in changed_files),
            "deletions": sum(file["deletions"] for file in changed_files),
        },
        "changed_files": shown_files,
        "truncation": {
            "limit": limit,
            "shown": len(shown_files),
            "total": total_files,
            "truncated": truncated,
            "narrowing_hints": ["Use --path <path> to filter changed files.", "Use --limit <n> to raise or lower the bound."] if truncated else [],
        },
        "unknowns": [],
    }


def load_json_file(path_value: str | None, label: str) -> tuple[dict[str, Any] | None, int]:
    if not path_value:
        return None, fail(
            f"missing required --{label}",
            f"Run with --{label} <path>.",
            valid_values=[f"--{label}"],
        )
    path = Path(path_value)
    if not path.is_file():
        return None, fail(
            f"{label} file was not found",
            f"Expected a readable JSON file at {path}.",
            code=4,
            error_code="resource_not_found",
        )
    try:
        with path.open(encoding="utf-8") as handle:
            return json.load(handle), 0
    except json.JSONDecodeError as exc:
        return None, fail(
            f"{label} is not valid JSON",
            f"{exc.msg} at line {exc.lineno}, column {exc.colno}.",
            code=3,
            error_code="validation_failed",
        )


def path_matches(pattern: str, path: str) -> bool:
    if fnmatch(path, pattern):
        return True
    if "*" not in pattern and not pattern.endswith("/") and path.startswith(pattern.rstrip("/") + "/"):
        return True
    return False


def impact_command(options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    review_state, code = load_json_file(options.get("review_state"), "review-state")
    if code != 0:
        return code, None
    diff_report, code = load_json_file(options.get("diff_report"), "diff-report")
    if code != 0:
        return code, None
    assert review_state is not None
    assert diff_report is not None

    claims = review_state.get("claims", [])
    changed_files = diff_report.get("changed_files", [])
    path_hits: list[dict[str, Any]] = []
    impacted_ids: set[str] = set()
    matched_files: set[str] = set()

    for claim in claims:
        claim_id = claim.get("id")
        watch_paths = claim.get("watch_paths", [])
        matches: list[str] = []
        for changed in changed_files:
            changed_path = changed.get("path", "")
            if any(path_matches(pattern, changed_path) for pattern in watch_paths):
                matches.append(changed_path)
                matched_files.add(changed_path)
        if matches and claim_id:
            path_hits.append({"claim_id": claim_id, "matched_paths": sorted(set(matches))})
            impacted_ids.add(claim_id)

    trigger_hits = diff_report.get("trigger_hits", [])
    for hit in trigger_hits:
        claim_id = hit.get("claim_id")
        if claim_id:
            impacted_ids.add(claim_id)

    impacted_claims: list[dict[str, Any]] = []
    for claim_id in sorted(impacted_ids):
        surfaced_by = []
        if any(hit["claim_id"] == claim_id for hit in path_hits):
            surfaced_by.append("path_hit")
        if any(hit.get("claim_id") == claim_id for hit in trigger_hits):
            surfaced_by.append("trigger_hit")
        impacted_claims.append(
            {
                "claim_id": claim_id,
                "impact": "unknown",
                "surfaced_by": surfaced_by or ["unknown"],
                "reason": "Claim surfaced by " + ", ".join(surfaced_by or ["unknown mapping"]) + ".",
                "required_followup_passes": ["trace"],
            }
        )

    unaffected_claims = [
        {
            "claim_id": claim.get("id"),
            "reason": "No changed file matched watch_paths and no trigger hit was supplied.",
        }
        for claim in claims
        if claim.get("id") not in impacted_ids
    ]

    unknowns = list(diff_report.get("unknowns", []))
    for changed in changed_files:
        changed_path = changed.get("path")
        if changed_path and changed_path not in matched_files:
            unknowns.append(
                {
                    "changed_file": changed_path,
                    "classification": ",".join(changed.get("classifications", [])),
                    "reason": "No claim watch_path matched this changed file; semantic trigger evaluation may still be needed.",
                }
            )

    return 0, {
        "schema_version": SCHEMA_VERSION,
        "from_review": review_state.get("id"),
        "to_repo_commit": diff_report.get("range", {}).get("to_commit"),
        "diff_range": diff_report.get("range", {}).get("expression"),
        "path_hits": path_hits,
        "trigger_hits": trigger_hits,
        "impacted_claims": impacted_claims,
        "unaffected_claims": unaffected_claims,
        "unknowns": unknowns,
    }


def compact_json(data: dict[str, Any]) -> str:
    return json.dumps(data, indent=2, sort_keys=True)


def build_delta_prompt(review_state: dict[str, Any], diff_report: dict[str, Any], impact_plan: dict[str, Any]) -> str:
    impacted = impact_plan.get("impacted_claims", [])
    return "\n".join(
        [
            "# Delta Trace Prompt Packet",
            "",
            "You are updating an existing repo-review state. Do not rerun a full review.",
            "",
            "## Required Output",
            "",
            "- Include `produced_by_analyzer` with analyzer identity.",
            "- Update only claims surfaced by the impact plan unless new evidence requires a new claim.",
            "- Label each meaningful update as `subject_drift`, `analysis_drift`, or `both`.",
            "- Preserve contested or uncertain claims instead of silently adjudicating them.",
            "",
            "## Conflation Guard",
            "",
            "Keep intra-review delta, inter-version delta, analysis drift, and subject drift separate. A corrected interpretation of unchanged evidence is analysis drift, not proof that the repo changed.",
            "",
            "## Impact Summary",
            "",
            f"Impacted claims: {len(impacted)}",
            f"Unknowns: {len(impact_plan.get('unknowns', []))}",
            "",
            "## Prior Review State",
            "",
            "```json",
            compact_json(review_state),
            "```",
            "",
            "## Diff Report",
            "",
            "```json",
            compact_json(diff_report),
            "```",
            "",
            "## Impact Plan",
            "",
            "```json",
            compact_json(impact_plan),
            "```",
            "",
        ]
    )


def export_prompt_command(options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    pass_id = options.get("pass")
    if pass_id != "delta-trace":
        return fail(
            "unsupported or missing --pass",
            "Run: repo-review export-prompt --pass delta-trace --output <path> --json --no-input",
            valid_values=["delta-trace"],
        ), None
    output = options.get("output")
    if not output:
        return fail("missing required --output", "Run with --output <path>.", valid_values=["--output"]), None

    required_inputs = ["review-state", "diff-report", "impact-plan"]
    if options.get("dry_run"):
        return 0, {
            "schema_version": SCHEMA_VERSION,
            "dry_run": True,
            "would_write": str(Path(output)),
            "required_inputs": required_inputs,
            "missing_inputs": [name for name in required_inputs if not options.get(name.replace("-", "_"))],
        }

    review_state, code = load_json_file(options.get("review_state"), "review-state")
    if code != 0:
        return code, None
    diff_report, code = load_json_file(options.get("diff_report"), "diff-report")
    if code != 0:
        return code, None
    impact_plan, code = load_json_file(options.get("impact_plan"), "impact-plan")
    if code != 0:
        return code, None
    assert review_state is not None
    assert diff_report is not None
    assert impact_plan is not None

    output_path = Path(output)
    if output_path.exists() and not options.get("overwrite"):
        return fail(
            "output path already exists",
            "Add --overwrite to replace the existing prompt packet.",
            code=5,
            error_code="unsafe_mutation_refused",
            valid_values=["--overwrite"],
        ), None
    output_path.parent.mkdir(parents=True, exist_ok=True)
    prompt = build_delta_prompt(review_state, diff_report, impact_plan)
    temp_path = output_path.with_suffix(output_path.suffix + ".tmp")
    temp_path.write_text(prompt, encoding="utf-8")
    temp_path.replace(output_path)
    return 0, {
        "schema_version": SCHEMA_VERSION,
        "path": str(output_path),
        "bytes_written": output_path.stat().st_size,
        "pass": pass_id,
        "overwritten": bool(options.get("overwrite")),
    }


def resolve_config(options: dict[str, Any]) -> dict[str, Any]:
    profiles = load_profiles()
    selected_profile = options.get("profile")
    profile = profiles.get(selected_profile, {}) if selected_profile else {}

    fields = {
        "repo_root": {
            "flag": "repo",
            "env": "REPO_REVIEW_REPO",
            "profile": "repo_root",
            "default": str(ROOT),
        },
        "review_output_dir": {
            "flag": "output",
            "env": "REPO_REVIEW_OUTPUT",
            "profile": "review_output_dir",
            "default": str(ROOT / "reviews"),
        },
        "analyzer_id": {
            "flag": "analyzer_id",
            "env": "REPO_REVIEW_ANALYZER_ID",
            "profile": "analyzer_id",
            "default": "unknown",
        },
        "lane_vocabulary_path": {
            "flag": "lane_vocabulary",
            "env": "REPO_REVIEW_LANE_VOCABULARY",
            "profile": "lane_vocabulary_path",
            "default": None,
        },
        "output_mode": {
            "flag": "output_mode",
            "env": "REPO_REVIEW_OUTPUT_MODE",
            "profile": "output_mode",
            "default": "json",
        },
    }

    configured: dict[str, Any] = {}
    sources: dict[str, str] = {}
    for field, spec in fields.items():
        flag_name = spec["flag"]
        if options.get(flag_name) not in (None, ""):
            configured[field] = options[flag_name]
            sources[field] = "flag"
        elif os.environ.get(spec["env"]):
            configured[field] = os.environ[spec["env"]]
            sources[field] = "environment"
        elif profile.get(spec["profile"]) not in (None, ""):
            configured[field] = profile[spec["profile"]]
            sources[field] = "profile"
        else:
            configured[field] = spec["default"]
            sources[field] = "default"

    return {
        "profile": selected_profile,
        "configured_paths": configured,
        "sources": sources,
    }


def status(options: dict[str, Any]) -> dict[str, Any]:
    config = resolve_config(options)
    return {
        "schema_version": SCHEMA_VERSION,
        **config,
        "available_profiles": profile_names(),
        "next_actions": [
            {
                "action": "run_first_read",
                "reason": "No review-state discovery is implemented in this CLI slice.",
                "recommended_command": "repo-review skill-path --json",
            }
        ],
    }


def profile_command(positionals: list[str], options: dict[str, Any]) -> tuple[int, dict[str, Any] | None]:
    if not positionals:
        values = ["list", "show", "save", "delete"]
        return fail("missing profile subcommand", "Use one of: list, show, save, delete.", valid_values=values), None
    subcommand, *rest = positionals
    profiles = load_profiles()

    if subcommand == "list":
        return 0, {"schema_version": SCHEMA_VERSION, "profiles": sorted(profiles)}

    if subcommand == "show":
        if not rest:
            return fail("missing profile name", "Run: repo-review profile show <name> --json"), None
        name = rest[0]
        if name not in profiles:
            values = sorted(profiles)
            return fail(
                f"profile '{name}' was not found",
                f"Use one of: {', '.join(values) or '(none)'}.",
                code=4,
                error_code="resource_not_found",
                valid_values=values,
            ), None
        return 0, {"schema_version": SCHEMA_VERSION, "name": name, "profile": profiles[name]}

    if subcommand == "save":
        if not rest:
            return fail("missing profile name", "Run: repo-review profile save <name> --repo <path> --output <path> --json --no-input"), None
        name = rest[0]
        profile = {
            "repo_root": options.get("repo") or str(ROOT),
            "review_output_dir": options.get("output") or str(ROOT / "reviews"),
            "analyzer_id": options.get("analyzer_id") or "unknown",
            "lane_vocabulary_path": options.get("lane_vocabulary"),
            "output_mode": options.get("output_mode") or "json",
        }
        profiles[name] = profile
        save_profiles(profiles)
        return 0, {"schema_version": SCHEMA_VERSION, "name": name, "profile": profile, "path": str(PROFILES_PATH)}

    if subcommand == "delete":
        if not rest:
            return fail("missing profile name", "Run: repo-review profile delete <name> --force --json --no-input"), None
        if not options.get("force"):
            return fail(
                "unsafe mutation refused",
                "Add --force to delete a profile.",
                code=5,
                error_code="unsafe_mutation_refused",
                valid_values=["--force"],
            ), None
        name = rest[0]
        existed = name in profiles
        profiles.pop(name, None)
        save_profiles(profiles)
        return 0, {"schema_version": SCHEMA_VERSION, "name": name, "deleted": existed, "path": str(PROFILES_PATH)}

    values = ["list", "show", "save", "delete"]
    return fail(f"unknown profile subcommand '{subcommand}'", "Use one of: list, show, save, delete.", valid_values=values), None


def feedback(positionals: list[str]) -> dict[str, Any] | tuple[int, None]:
    if not positionals:
        return fail("missing feedback message", "Run: repo-review feedback \"message\" --json --no-input"), None
    STATE_DIR.mkdir(exist_ok=True)
    created_at = datetime.now(timezone.utc).replace(microsecond=0).isoformat()
    entry_id = "feedback-" + created_at.replace(":", "").replace("+", "Z")
    entry = {
        "schema_version": SCHEMA_VERSION,
        "entry_id": entry_id,
        "created_at": created_at,
        "message": " ".join(positionals),
    }
    with FEEDBACK_PATH.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(entry, sort_keys=True) + "\n")
    return {"schema_version": SCHEMA_VERSION, "entry_id": entry_id, "path": str(FEEDBACK_PATH)}


def main(argv: list[str]) -> int:
    if not argv or argv[0] in {"-h", "--help"}:
        commands = ", ".join(sorted(COMMANDS))
        return fail(
            "missing command",
            f"Use one of: {commands}. Example: repo-review agent-context --json",
            valid_values=sorted(COMMANDS),
        )

    command, *args = argv
    if command not in COMMANDS:
        commands = ", ".join(sorted(COMMANDS))
        return fail(f"unknown command '{command}'", f"Use one of: {commands}.", valid_values=sorted(COMMANDS))

    if not require_json(args):
        return fail(
            f"{command} requires --json in the current CLI slice",
            f"Run: repo-review {command} --json",
        )

    positionals, options = parse_args(args)

    if command == "agent-context":
        return emit_json(agent_context())
    if command == "diff":
        code, payload = diff_command(options)
        if code != 0:
            return code
        return emit_json(payload or {})
    if command == "feedback":
        result = feedback(positionals)
        if isinstance(result, tuple):
            code, _ = result
            return code
        return emit_json(result)
    if command == "export-prompt":
        code, payload = export_prompt_command(options)
        if code != 0:
            return code
        return emit_json(payload or {})
    if command == "impact":
        code, payload = impact_command(options)
        if code != 0:
            return code
        return emit_json(payload or {})
    if command == "profile":
        code, payload = profile_command(positionals, options)
        if code != 0:
            return code
        return emit_json(payload or {})
    if command == "skill-path":
        if not MANIFEST_DIR.is_dir() or not MANIFEST_PATH.is_file():
            return fail(
                "skill manifest is missing",
                f"Expected readable manifest at {MANIFEST_PATH}.",
                code=4,
                error_code="resource_not_found",
            )
        return emit_json(skill_path())
    if command == "status":
        return emit_json(status(options))

    return fail(f"command '{command}' is registered but not implemented", "Check agent-context for shipped commands.", code=1)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
