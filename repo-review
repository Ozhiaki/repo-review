def extract_marked_command_registry(text: str) -> str | None:
    start = text.find(COMMAND_REGISTRY_START)
    end = text.find(COMMAND_REGISTRY_END)
    if start == -1 or end == -1 or end < start:
        return None
    return text[start : end + len(COMMAND_REGISTRY_END)]


